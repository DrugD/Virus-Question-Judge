# Judge LLM gateway key — used by `python -m eval.batch_judge` for the real
# scoring pass. Copy this file to `.env` and replace the placeholder.
#
#   cp .env.example .env   # then edit NEWAPI_KEY
#
# NOTE:
#  * `--dry-run` does NOT need a key (it only desensitizes + validates).
#  * The real evaluation (judge calls) requires a valid key here.
#  * `.env` is gitignored — never commit your real key.
NEWAPI_KEY=sk-REPLACE_ME
