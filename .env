# =============================================================================
# Fill in your new-api sk key below, then save.
# run_pipeline.py / run_judge.py auto-load this file via python-dotenv.
# =============================================================================

# ★ One key powers judge + every agent.
NEWAPI_KEY=sk-xxx

# new-api gateway. Real API gateway port = 3888 (NOT 3111 — that's the docs site).
# OpenAI-compatible chat path is /v1/chat/completions.
NEWAPI_BASE_URL=http://35.220.164.252:3888/v1

# --- Codex CLI knobs (only used if you run the codex-cli agent) --------------
OPENAI_BASE_URL=http://35.220.164.252:3888/v1
# OPENAI_API_KEY is set automatically from NEWAPI_KEY at runtime.

# --- Claude Code CLI knobs (only used if you run the claude-code agent) ------
# Mirrors the VSCode Claude Code extension config you already use.
ANTHROPIC_BASE_URL=http://35.220.164.252:3888
# ANTHROPIC_AUTH_TOKEN is set automatically from NEWAPI_KEY at runtime.
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
ANTHROPIC_DEFAULT_SONNET_MODEL=gemini-3.1-pro-preview

# --- InternLM (Shanghai AI Lab · 浦语) ---------------------------------------
# Used by the intern-s1 / intern-s1-pro / intern-s1-mini / intern-s2-preview agents.
# Endpoint is OpenAI-compatible: POST https://chat.intern-ai.org.cn/api/v1/chat/completions
# Get a key at https://internlm.intern-ai.org.cn/  →  console / API Keys.
# If this slot is empty or the key has expired, those 4 agents will fail at
# runtime with "INTERN_AI_KEY not set" or "user token expired" — fix here.
INTERN_AI_KEY=sk-xxx

