import zipfile, xml.etree.ElementTree as ET, re, collections, math
ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
with zipfile.ZipFile('data/43705_2022_180_MOESM1_ESM.docx') as z: root=ET.fromstring(z.read('word/document.xml'))
def text_of(el):
    out=[]
    for n in el.iter():
        tag=n.tag.rsplit('}',1)[-1]
        if tag=='t' and n.text: out.append(n.text)
        elif tag=='tab': out.append('\\t')
    return ''.join(out)
rows=[]
for tr in root.find('.//w:tbl', ns).findall('w:tr', ns): rows.append([re.sub(r'\\s+',' ',text_of(tc)).strip() for tc in tr.findall('w:tc',ns)])
header=rows[0]
valid=[r for r in rows[1:] if len(r)>=7 and r[3].startswith('SRR')]
D=[dict(zip(header,r)) for r in valid]
print('valid_entries',len(D))
print('unique_sra',len(set(d['SRA Accession'] for d in D)))
print('duplicate_sra',[k for k,v in collections.Counter(d['SRA Accession'] for d in D).items() if v>1])
print('unique_scientific_names',len(set(d['Scientific name'] for d in D)))
print('animal_type_counts',collections.Counter(d['Animal type'] for d in D))
print('animal_type_percent',{k:round(v/len(D)*100,1) for k,v in collections.Counter(d['Animal type'] for d in D).items()})
print('countries',len(set(d['Country of origin'] for d in D)),collections.Counter(d['Country of origin'] for d in D).most_common(10))
print('tissues',len(set(d['Tissue'] for d in D)),collections.Counter(d['Tissue'] for d in D).most_common(10))
print('platforms_raw',len(set(d['Sequencing platform'] for d in D)),collections.Counter(d['Sequencing platform'] for d in D).most_common())
star=sum('*' in d['Sequencing platform'] for d in D)
print('polyA_starred',star,round(star/len(D)*100,1))
print('liver_or_mixed_viscera',sum(d['Tissue'] in ['Liver','Mixed viscera'] for d in D),round(sum(d['Tissue'] in ['Liver','Mixed viscera'] for d in D)/len(D)*100,1))
print('top_species',collections.Counter(d['Scientific name'] for d in D).most_common(12))
print('amph_countries',len(set(d['Country of origin'] for d in D if d['Animal type']=='Amphibian')),collections.Counter(d['Country of origin'] for d in D if d['Animal type']=='Amphibian').most_common(8))
print('rept_countries',len(set(d['Country of origin'] for d in D if d['Animal type']=='Reptile')),collections.Counter(d['Country of origin'] for d in D if d['Animal type']=='Reptile').most_common(8))
