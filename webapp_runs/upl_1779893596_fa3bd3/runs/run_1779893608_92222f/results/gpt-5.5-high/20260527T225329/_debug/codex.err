import zipfile, xml.etree.ElementTree as ET, re, collections
path='data/43705_2022_180_MOESM1_ESM.docx'
ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
with zipfile.ZipFile(path) as z:
    root=ET.fromstring(z.read('word/document.xml'))

def text_of(el):
    parts=[]
    for node in el.iter():
        tag=node.tag.rsplit('}',1)[-1]
        if tag=='t' and node.text: parts.append(node.text)
        elif tag=='tab': parts.append('\\t')
        elif tag=='br': parts.append('\\n')
    return ''.join(parts)

tbl=root.find('.//w:tbl', ns)
rows=[]
for tr in tbl.findall('w:tr', ns):
    cells=[re.sub(r'\\s+',' ', text_of(tc)).strip() for tc in tr.findall('w:tc',ns)]
    rows.append(cells)
header=rows[0]; data=[dict(zip(header,r)) for r in rows[1:]]
print('rows', len(data))
for col in header:
    vals=[d.get(col,'') for d in data]
    print('\\nCOL', col, 'nonblank', sum(1 for v in vals if v), 'unique_nonblank', len(set(v for v in vals if v)))
    print(collections.Counter(v for v in vals if v).most_common(20))
print('\\nblank species rows', sum(1 for d in data if not d['Species']))
# Country corrections and composite values
print('\\nCountries raw all:', sorted(set(d['Country of origin'] for d in data)))
print('\\nAnimal by country:')
for c, n in collections.Counter((d['Animal type'], d['Country of origin']) for d in data).most_common(50): print(c,n)
print('\\nScientific species counts top 30:')
for k,v in collections.Counter(d['Scientific name'] for d in data if d['Scientific name']).most_common(40): print(v,k)
print('\\nTissues all:')
for k,v in collections.Counter(d['Tissue'] for d in data if d['Tissue']).most_common(): print(v,k)
print('\\nPlatforms all:')
for k,v in collections.Counter(d['Sequencing platform'] for d in data if d['Sequencing platform']).most_common(): print(v,k)
