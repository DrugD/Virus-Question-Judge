import zipfile, xml.etree.ElementTree as ET, re
path='data/43705_2022_180_MOESM1_ESM.docx'
ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
with zipfile.ZipFile(path) as z:
    xml=z.read('word/document.xml')
root=ET.fromstring(xml)

def text_of(el):
    parts=[]
    for node in el.iter():
        tag=node.tag.rsplit('}',1)[-1]
        if tag=='t' and node.text:
            parts.append(node.text)
        elif tag=='tab':
            parts.append('\\t')
        elif tag=='br':
            parts.append('\\n')
    return ''.join(parts)

body=root.find('w:body',ns)
for i, child in enumerate(body):
    tag=child.tag.rsplit('}',1)[-1]
    if tag=='p':
        txt=text_of(child).strip()
        if txt:
            print(f'P\\t{i}\\t{txt}')
    elif tag=='tbl':
        rows=[]
        for tr in child.findall('w:tr',ns):
            cells=[re.sub(r'\\s+',' ', text_of(tc)).strip() for tc in tr.findall('w:tc',ns)]
            rows.append(cells)
        print(f'TABLE\\t{i}\\trows={len(rows)}\\tcols={max(map(len,rows)) if rows else 0}')
        for r,row in enumerate(rows[:8]): print('ROW\\t%d\\t%s' % (r, ' | '.join(row)))
        if len(rows)>8: print('...')
