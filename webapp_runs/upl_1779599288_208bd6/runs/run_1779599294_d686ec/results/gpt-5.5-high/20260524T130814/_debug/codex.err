/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from collections import Counter, defaultdict
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]
h=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if h is not None:
            s=''.join(seq).upper(); records.append((h,s))
        h=line[1:].strip(); seq=[]
    elif line.strip(): seq.append(line.strip())
if h is not None:
    s=''.join(seq).upper(); records.append((h,s))
print('records',len(records))
print('total_nt',sum(len(s) for h,s in records))
lengths=[len(s) for h,s in records]
print('min max mean median',min(lengths),max(lengths),sum(lengths)/len(lengths),sorted(lengths)[len(lengths)//2])
print('lengths sorted',sorted(lengths))
for i,(h,s) in enumerate(records,1):
    gc=(s.count('G')+s.count('C'))/len(s)*100
    n=sum(1 for c in s if c not in 'ACGT')
    print(f'{i:02d}\\t{len(s):5d}\\tGC={gc:5.2f}\\tN={n}\\t{h}')
print('ambiguous total',sum(sum(1 for c in s if c not in 'ACGT') for h,s in records))
# group by virus before strain
for h,s in records:
    name=h.split(' strain ')[0].split(' polyprotein ')[0]
    # remove accession
    name=' '.join(name.split()[1:])
    # for headers without strain? none
    print('GROUPKEY', name)
