by=defaultdict(list)
for h,s in seg: by[virus_name(h)].append((h,s))
for v,rs in by.items():
    lens=[len(s) for h,s in rs]
    gcs=[(s.count('G')+s.count('C'))/len(s)*100 for h,s in rs]
    print('\\n',v,'n',len(rs),'total_len',sum(lens),'lens',lens,'meanGC',round(sum(gcs)/len(gcs),2),'rangeGC',round(min(gcs),2),round(max(gcs),2))
