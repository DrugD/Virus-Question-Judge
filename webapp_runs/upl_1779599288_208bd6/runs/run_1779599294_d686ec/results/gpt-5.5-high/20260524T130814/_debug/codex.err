    if ' strain ' in rest: return rest.split(' strain ')[0]
    if ' polyprotein ' in rest: return rest.split(' polyprotein ')[0]
    return rest
seg=[]; poly=[]
for h,s in records:
    (seg if ' segment ' in h else poly).append((h,s))
