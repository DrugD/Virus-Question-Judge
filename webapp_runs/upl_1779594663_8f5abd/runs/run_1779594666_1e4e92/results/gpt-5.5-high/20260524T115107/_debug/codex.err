@@ -0,0 +1,119 @@
+{
+  "agent_id": "gpt-5.5-high-codex",
+  "questions": [
+    {
+      "rank": 1,
+      "question": "What novel RNA viruses can be detected in publicly available amphibian and reptile RNA-seq datasets, and how do their phylogenetic placements within Bunyavirales, reptile lyssaviruses, Hepeviridae, Astroviridae, influenza viruses, and caliciviruses expand known herptile virus diversity?",
+      "rationale": "The DOCX combines a 235-row public RNA-seq accession table for amphibians and reptiles with captions describing viral contig discovery and phylogenetic trees for multiple RNA virus groups. The figure captions explicitly mention BLAST searches against viral proteins, in silico translation, MAFFT alignments, and RAxML trees, making phylogenetic placement central to the dataset. This question captures the broad biological opportunity supported by both the accession metadata and the viral-family figure captions.",
+      "data_support": [
+        "data/43705_2022_180_MOESM1_ESM.docx",
+        "Supplementary Table 1: Publicly available RNA-Sequencing datasets used in this study",
+        "SRA Accession",
+        "Animal type",
+        "Supplementary Figure 1: Novel reptile Bunyavirales",
+        "Supplementary Figure 2: Reptile lyssaviruses",
+        "Supplementary Figure 3: Novel amphibian and reptile Hepeviridae and Astroviridae",
+        "Supplementary Figure 4: Novel newt influenza virus",
+        "Supplementary Figure 5: Novel newt calicivirus"
+      ],
+      "expected_test": "Mine the listed SRA RNA-seq datasets for viral contigs using BLAST against viral protein references, translate candidate viral genes or polyproteins, align them with MAFFT, and infer RAxML phylogenies to determine whether they form novel lineages relative to known viruses.",
+      "scope_keywords": [
+        "herptile virome",
+        "RNA-seq",
+        "viral discovery",
+        "phylogenetics",
+        "Bunyavirales",
+        "lyssavirus",
+        "influenza",
+        "calicivirus"
+      ]
+    },
+    {
+      "rank": 2,
+      "question": "How does the uneven distribution of host class, tissue type, country of origin, and sequencing platform in the 235 amphibian and reptile RNA-seq accessions shape the likelihood of detecting novel herptile RNA viruses?",
+      "rationale": "The accession table is strongly imbalanced, with 156 reptile rows versus 79 amphibian rows, liver and mixed viscera dominating tissue coverage, and French Giana, China, USA, Unknown, Australia, and Cuba leading country counts. Platform representation is also concentrated in Illumina HiSeq 2000 and NextSeq 500 datasets. These metadata gradients could affect viral discovery sensitivity and apparent host or geographic patterns.",
+      "data_support": [
+        "data/43705_2022_180_MOESM1_ESM.docx",
+        "Animal type",
+        "Country of origin",
+        "Tissue",
+        "Sequencing platform",
+        "SRA Accession"
+      ],
+      "expected_test": "Model viral-contig detection or discovery yield as a function of animal type, tissue, country/origin category, sequencing platform, and PolyA-selection status across the accession table.",
+      "scope_keywords": [
+        "sampling bias",
+        "host class",
+        "tissue",
+        "country",
+        "platform",
+        "viral yield"
+      ]
+    },
+    {
+      "rank": 3,
+      "question": "Do amphibian and reptile transcriptomes from geographically concentrated sampling regions such as French Giana, China, the USA, Australia, Cuba, India, Denmark, and Madagascar reveal distinct pools of novel RNA viruses?",
+      "rationale": "The table covers 29 country/origin categories, but the top eight account for most accessions and include both amphibian-heavy and reptile-heavy subsets. Viral discoveries in the figure captions can be mapped back to host metadata and country of origin if contigs are associated with specific SRA runs. This would test whether observed herptile viral diversity tracks geography or mainly reflects sampling density.",
+      "data_support": [
+        "data/43705_2022_180_MOESM1_ESM.docx",
+        "Country of origin",
+        "Scientific name",
+        "Animal type",
+        "SRA Accession"
+      ],
+      "expected_test": "Associate detected viral contigs with SRA accessions and compare viral-family occurrence, phylogenetic clustering, and discovery rates across the country/origin categories in the table.",
+      "scope_keywords": [
+        "geography",
+        "French Giana",
+        "China",
+        "USA",
+        "Australia",
+        "viral biogeography"
+      ]
+    },
+    {
+      "rank": 4,
+      "question": "Do the novel amphibian and reptile hepevirus and astrovirus contigs show different structural and non-structural gene phylogenies consistent with recombination near the common breakpoint indicated in the supplementary figure?",
+      "rationale": "Supplementary Figure 3 describes separate genomic structure views and phylogenies for astrovirus and hepevirus non-structural genes and hepevirus structural capsid genes. The caption also marks a common recombination breakpoint with a red arrow. That makes recombination and phylogenetic incongruence a specific, testable evolutionary question within one viral subset.",
+      "data_support": [
+        "data/43705_2022_180_MOESM1_ESM.docx",
+        "Supplementary Figure 3: Novel amphibian and reptile Hepeviridae and Astroviridae",
+        "non-structural gene",
+        "structural capsid genes",
+        "common recombination breakpoint"
+      ],
+      "expected_test": "Compare MAFFT/RAxML phylogenies inferred from non-structural and structural regions of the detected hepevirus and astrovirus contigs, then test for topology shifts around the annotated breakpoint.",
+      "scope_keywords": [
+        "Hepeviridae",
+        "Astroviridae",
+        "recombination",
+        "capsid",
+        "non-structural genes",
+        "phylogenetic incongruence"
+      ]
+    },
+    {
+      "rank": 5,
+      "question": "Which amphibian and reptile host lineages in the public RNA-seq accession table are the strongest priorities for future herptile RNA virus surveillance based on taxonomic representation, tissue coverage, and the viral families highlighted in the supplementary figures?",
+      "rationale": "The table includes 122 scientific names, with heavily represented hosts such as Thamnophis elegans, Pelodiscus sinensis, Python bivittatus, Microcaecilia unicolor, Caecilia tentaculata, Rhinatrema bivittatum, and Anolis species. The supplementary captions point to several discovered viral groups, including Bunyavirales, lyssavirus-like rhabdoviruses, hepeviruses, astroviruses, influenza virus, and calicivirus. Combining host representation with viral discoveries can prioritize lineages where additional transcriptome mining or surveillance is most justified.",
+      "data_support": [
+        "data/43705_2022_180_MOESM1_ESM.docx",
+        "Scientific name",
+        "Species",
+        "Tissue",
+        "Animal type",
+        "Supplementary Figure 1: Novel reptile Bunyavirales",
+        "Supplementary Figure 2: Reptile lyssaviruses"
+      ],
+      "expected_test": "Rank host lineages by number of accessions, tissue breadth, detected viral contig diversity, and phylogenetic novelty among the viral families described in the figure captions.",
+      "scope_keywords": [
+        "surveillance",
+        "host lineage",
+        "taxonomic breadth",
+        "tissue coverage",
+        "reptiles",
+        "amphibians"
+      ]
+    }
+  ]
+}
