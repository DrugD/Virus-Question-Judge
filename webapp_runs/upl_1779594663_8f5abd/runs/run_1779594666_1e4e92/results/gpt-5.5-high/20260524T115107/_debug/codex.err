root=ET.fromstring(zipfile.ZipFile('data/43705_2022_180_MOESM1_ESM.docx').read('word/document.xml'))
rows=[]
for tr in root.find('.//w:tbl',ns).findall('./w:tr',ns):
 cells=[]
 for tc in tr.findall('./w:tc',ns):
  cell=' '.join(''.join(t.text or '' for t in p.findall('.//w:t',ns)).strip() for p in tc.findall('.//w:p',ns))
  cell=re.sub(r'\\s+',' ',cell).strip(); cells.append(cell)
 rows.append(cells)
data=[r for r in rows[1:] if re.match(r'"'^(SRR|ERR|DRR)'"\\d+"'$'"', r[3])]
print('actual_dataset_rows', len(data), 'unique accessions', len(set(r[3] for r in data)))
print('animal', collections.Counter(r[2] for r in data).most_common())
print('countries unique/top', len(set(r[4] for r in data)), collections.Counter(r[4] for r in data).most_common(10))
print('tissues unique/top', len(set(r[5] for r in data)), collections.Counter(r[5] for r in data).most_common(12))
def norm_plat(s): return re.sub(r'\\s+',' ',s.replace('*','')).strip().replace('HiSeq2000','HiSeq 2000').replace('HiSeq4000','HiSeq 4000')
print('platforms', collections.Counter(norm_plat(r[6]) for r in data).most_common())
print('polyA', sum('*' in r[6] for r in data))
print('unique sci names', len(set(r[1] for r in data)))
