import zipfile, xml.etree.ElementTree as ET, collections, re
ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
root=ET.fromstring(zipfile.ZipFile('data/43705_2022_180_MOESM1_ESM.docx').read('word/document.xml'))
rows=[]
for tr in root.find('.//w:tbl',ns).findall('./w:tr',ns):
 cells=[]
 for tc in tr.findall('./w:tc',ns):
  cell=' '.join(''.join(t.text or '' for t in p.findall('.//w:t',ns)).strip() for p in tc.findall('.//w:p',ns))
  cell=re.sub(r'\\s+',' ',cell).strip(); cells.append(cell)
 rows.append(cells)
data=rows[1:]
print('scientific genera top')
genera=collections.Counter((r[1].split()[0] if r[1] else '') for r in data)
for k,v in genera.most_common(25): print(v,k)
print('\\nrows by animal/tissue-category')
def cat(t):
 l=t.lower()
 if 'liver' in l: return 'liver'
 if 'viscera' in l: return 'viscera'
 if 'skin' in l or 'pad' in l or 'gland' in l: return 'skin/gland'
 if 'kidney' in l or 'spleen' in l or 'heart' in l or 'lung' in l or 'blood' in l: return 'internal organ/blood'
 if 'intestine' in l or 'foregut' in l or 'gut' in l: return 'gut'
 if 'tadpole' in l or 'embryo' in l or 'adult' in l: return 'whole/life-stage'
 return 'other'
for animal in ['Amphibian','Reptile','']:
 c=collections.Counter(cat(r[5]) for r in data if r[2]==animal)
 print(animal or 'missing', c.most_common())
