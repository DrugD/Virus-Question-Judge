import zipfile, xml.etree.ElementTree as ET, collections, re
path='data/43705_2022_180_MOESM1_ESM.docx'
ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
with zipfile.ZipFile(path) as z:
    xml=z.read('word/document.xml')
root=ET.fromstring(xml)
# paragraphs
paras=[]
for p in root.findall('.//w:p', ns):
    txt=''.join(t.text or '' for t in p.findall('.//w:t', ns))
    if txt.strip(): paras.append(txt.strip())
print('paragraph_count', len(paras))
print('first_80_paragraphs')
for i,p in enumerate(paras[:80],1): print(f'{i}: {p}')
# tables
for ti,tbl in enumerate(root.findall('.//w:tbl', ns),1):
    rows=[]
    for tr in tbl.findall('./w:tr', ns):
        cells=[]
        for tc in tr.findall('./w:tc', ns):
            # join p with space
            cell=' '.join(''.join(t.text or '' for t in p.findall('.//w:t', ns)).strip() for p in tc.findall('.//w:p', ns))
            cell=re.sub(r'\\s+', ' ', cell).strip()
            cells.append(cell)
        rows.append(cells)
    print('TABLE', ti, 'rows', len(rows), 'cols_dist', collections.Counter(len(r) for r in rows))
    for r in rows[:5]: print(r)
