The table includes a footnote row and several non-SRR accession prefixes, so I’m separating real accession rows from the table artifact before using the counts. That avoids undercounting the public RNA-seq runs.
exec
/bin/zsh -lc "python3 - <<'PY'
import zipfile, xml.etree.ElementTree as ET, re, collections
ns={'w':'http://schemas.openxmlformats.org/wordprocessingml/2006/main'}
root=ET.fromstring(zipfile.ZipFile('data/43705_2022_180_MOESM1_ESM.docx').read('word/document.xml'))
rows=[]
for tr in root.find('.//w:tbl',ns).findall('./w:tr',ns):
 cells=[]
 for tc in tr.findall('./w:tc',ns):
  cell=' '.join(''.join(t.text or '' for t in p.findall('.//w:t',ns)).strip() for p in tc.findall('.//w:p',ns))
  cell=re.sub(r'\\s+',' ',cell).strip(); cells.append(cell)
 rows.append(cells)
data=[r for r in rows[1:] if r[3].strip()]
print('rows with accession', len(data))
print('prefix counts', collections.Counter(re.match(r'"'^[A-Z]+'"', r[3]).group(0) if re.match(r'"'^[A-Z]+'"', r[3]) else 'other' for r in data))
for r in rows[1:]:
 if r[3] and not re.match(r'"'^(SRR|ERR|DRR)'"\\d+"'$'"', r[3]): print('nonmatching', r)
