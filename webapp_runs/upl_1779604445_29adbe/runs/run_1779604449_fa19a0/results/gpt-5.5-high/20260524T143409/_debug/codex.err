import urllib.request, json, re, html, time, ssl
url='https://zenodo.org/api/records/7368133'
for i in range(6):
    try:
        req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=25) as r:
            data=json.load(r)
        break
    except Exception as e:
        print('attempt', i+1, type(e).__name__, e)
        time.sleep(2)
else:
    raise SystemExit(1)
md=data['metadata']
print(json.dumps({
 'id': data.get('id'), 'doi': data.get('doi'), 'conceptdoi': data.get('conceptdoi'),
 'created': data.get('created'), 'modified': data.get('modified'),
