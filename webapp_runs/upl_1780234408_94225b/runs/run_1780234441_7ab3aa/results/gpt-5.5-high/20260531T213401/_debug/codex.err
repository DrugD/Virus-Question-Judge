/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
import re, statistics
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]; h=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if h: records.append((h,''.join(seq).upper()))
        h=line[1:].strip(); seq=[]
    else: seq.append(line.strip())
if h: records.append((h,''.join(seq).upper()))
comp=str.maketrans('ACGT','TGCA')
def rc(s): return s.translate(comp)[::-1]
def longest_orf(seq):
    best=0
    for ss in [seq,rc(seq)]:
        for frame in range(3):
            i=frame
            while i<=len(ss)-3:
                if ss[i:i+3]=='ATG':
                    j=i+3
                    while j<=len(ss)-3 and ss[j:j+3] not in {'TAA','TAG','TGA'}:
                        j+=3
                    end=j+3 if j<=len(ss)-3 else len(ss)-((len(ss)-i)%3)
                    best=max(best,end-i); i=j+3
                else: i+=3
    return best
for label,flt in [('segmented',lambda h:' segment ' in h),('polyprotein',lambda h:'polyprotein gene' in h)]:
    cov=[]
    for h,s in records:
        if flt(h): cov.append(longest_orf(s)/len(s))
    print(label, 'orf_cov_mean', round(statistics.mean(cov),3),'median',round(statistics.median(cov),3),'range',round(min(cov),3),round(max(cov),3))
print('segment-by-number orf cov:')
for n in range(1,5):
    cov=[]; lens=[]; gcs=[]
    for h,s in records:
        if f'segment {n}' in h:
            cov.append(longest_orf(s)/len(s)); lens.append(len(s)); gcs.append((s.count('G')+s.count('C'))/len(s))
    print(n,'n',len(cov),'len_mean',round(statistics.mean(lens),1),'cov_mean',round(statistics.mean(cov),3),'gc_mean',round(100*statistics.mean(gcs),2))
