/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from collections import Counter, defaultdict
import re, statistics, math
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]
header=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if header: records.append((header,''.join(seq).upper()))
        header=line[1:].strip(); seq=[]
    else:
        seq.append(line.strip())
if header: records.append((header,''.join(seq).upper()))
print('records',len(records))
lengths=[len(s) for h,s in records]
print('total_nt',sum(lengths),'min',min(lengths),'max',max(lengths),'mean',round(statistics.mean(lengths),1),'median',statistics.median(lengths))
print('ambiguous',sum(sum(1 for c in s if c not in 'ACGT') for h,s in records))
print('gc_overall',round(100*sum(s.count('G')+s.count('C') for h,s in records)/sum(lengths),2))
# categories
seg=[]; poly=[]
for h,s in records:
    if ' segment ' in h: seg.append((h,s))
    if 'polyprotein gene' in h: poly.append((h,s))
print('seg',len(seg),'poly',len(poly))
for name, group in [('seg',seg),('poly',poly)]:
    L=[len(s) for h,s in group]
    print(name,'total',sum(L),'min',min(L),'max',max(L),'mean',round(statistics.mean(L),1),'gc',round(100*sum(s.count('G')+s.count('C') for h,s in group)/sum(L),2))
# extract virus/stain segment
print('\\nRecords detail:')
for h,s in records:
    acc=h.split()[0]
    gc=100*(s.count('G')+s.count('C'))/len(s)
    segm=re.search(r'segment (\\d+)',h)
    kind='seg'+segm.group(1) if segm else 'polyprotein'
    print(acc, len(s), f'{gc:.2f}', kind, h.split('.1 ',1)[1])
# group segmented by virus before strain
byvirus=defaultdict(list)
for h,s in seg:
    desc=h.split('.1 ',1)[1]
    virus=desc.split(' strain ')[0]
    m=re.search(r'segment (\\d+)',h)
    byvirus[virus].append((int(m.group(1)),h,s))
print('\\nSegmented viruses:')
for v,lst in byvirus.items():
    lst=sorted(lst)
    lens=[len(s) for _,h,s in lst]
    gcs=[100*(s.count('G')+s.count('C'))/len(s) for _,h,s in lst]
    print(v, 'segments',[i for i,_,_ in lst], 'total',sum(lens),'lens',lens,'gc',[round(x,1) for x in gcs])
    print('  5prime', [s[:12] for _,h,s in lst])
    print('  3prime', [s[-12:] for _,h,s in lst])
# terminal consensus positions among segmented
for n in [8,10,12,20]:
    starts=[s[:n] for h,s in seg]; ends=[s[-n:] for h,s in seg]
    print('\\nN',n)
    print('start top',Counter(starts).most_common(10))
    print('end top',Counter(ends).most_common(10))
# host categories from virus names maybe
hosts=['cricket','flea','insect','aphid','shark','spider','barnacle','fly','mosquito','lacewing','tick','centipede','water strider']
host_counts=Counter()
for h,s in records:
    desc=h.lower()
    for host in hosts:
        if host in desc:
            host_counts[host]+=1
            break
print('\\nhost_counts records',host_counts)
# distinct virus names for poly
print('\\npoly names')
for h,s in poly:
    desc=h.split('.1 ',1)[1]
    virus=desc.split(' strain ')[0]
    print(virus, len(s), f'GC {100*(s.count(\"G\")+s.count(\"C\"))/len(s):.1f}', s[:12], s[-12:])
# ORF analysis longest ORF both strands maybe standard stops incl TAA TAG TGA; start ATG. 
comp=str.maketrans('ACGT','TGCA')
def rc(s): return s.translate(comp)[::-1]
def longest_orf(seq):
    best=(0,None,None,None)
    for strand,ss in [('+',seq),('-',rc(seq))]:
        for frame in range(3):
            i=frame
            while i<=len(ss)-3:
                cod=ss[i:i+3]
                if cod=='ATG':
                    j=i+3
                    while j<=len(ss)-3 and ss[j:j+3] not in {'TAA','TAG','TGA'}:
                        j+=3
                    end=j+3 if j<=len(ss)-3 else len(ss)-((len(ss)-i)%3)
                    l=end-i
                    if l>best[0]: best=(l,strand,frame,i)
                    i=j+3
                else:
                    i+=3
    return best
print('\\nLongest ORFs')
for h,s in records:
    l,strand,frame,start=longest_orf(s)
    print(h.split()[0],len(s),l,round(l/len(s),3),strand,frame,start)
