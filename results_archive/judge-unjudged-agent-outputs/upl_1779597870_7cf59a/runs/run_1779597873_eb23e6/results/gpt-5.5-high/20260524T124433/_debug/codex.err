import tarfile, re, collections, statistics
with tarfile.open('data/43059583_BtCN-Virome_full_spectrum_contigs.tar.gz','r:gz') as tf:
    text=tf.extractfile('BtCN-Virome_full_spectrum.fna').read().decode('utf-8','ignore')
headers=re.findall(r'"'^>(.*)'"', text, re.M)
prefixes=[h.split('|')[0] for h in headers]
print('unique_prefixes', len(set(prefixes)))
print('top_prefixes', collections.Counter(prefixes).most_common(20))
print('prefix_samples', sorted(set(prefixes))[:50])
# year suffix maybe last two digits or _N
print('all header samples last 10', headers[-10:])
# lengths/coverages per prefix top by total bp and avg coverage
stats={}
seq_len=0; current=None
lengths={}
for line in text.splitlines():
    if line.startswith('>'):
        h=line[1:]
        current=h.split('|')[0]
        m=re.search(r'_length_(\\d+)', h)
        length=int(m.group(1)) if m else None
        lengths.setdefault(current,[]).append(length)
for p,L in sorted(lengths.items(), key=lambda kv: sum(kv[1]), reverse=True)[:15]:
    print(p, 'n', len(L), 'bp', sum(L), 'median_len', statistics.median(L), 'max', max(L))
