import zipfile, csv, io, collections, statistics, math, tarfile
from pathlib import Path
root=Path('data')

def corr(xs, ys):
    if len(xs)<2: return None
    sx=statistics.pstdev(xs); sy=statistics.pstdev(ys)
    if sx==0 or sy==0: return None
    mx=statistics.mean(xs); my=statistics.mean(ys)
    return sum((x-mx)*(y-my) for x,y in zip(xs,ys))/(len(xs)*sx*sy)

with zipfile.ZipFile(root/'45561465_Meta_data_for_ecological_modeling.zip') as z:
    for name in z.namelist():
        if name.endswith('.txt'):
            rows=list(csv.DictReader(io.StringIO(z.read(name).decode('utf-8-sig')), delimiter='\\t'))
            print('\\nFILE', name)
            print('rows', len(rows), 'columns', list(rows[0].keys()))
            resp='tvs' if 'tvs' in rows[0] else 'tv'
            vals=[float(r[resp]) for r in rows if r.get(resp)]
            print(resp, 'mean', round(statistics.mean(vals),3), 'median', round(statistics.median(vals),3), 'range', round(min(vals),3), round(max(vals),3))
            for col in ['family','st','sample size','sp']:
                if col in rows[0]: print(col, dict(collections.Counter(r[col] for r in rows)))
            nums=[c for c in rows[0] if c not in {'Pool_code','family','st'}]
            cors=[]
            for col in nums:
                if col == resp: continue
                try:
                    xs=[]; ys=[]
                    for r in rows:
                        if r.get(col) not in ('', None) and r.get(resp) not in ('', None):
                            xs.append(float(r[col])); ys.append(float(r[resp]))
                    c=corr(xs, ys)
                    if c is not None: cors.append((abs(c), c, col))
                except ValueError:
                    pass
            print('top correlations vs', resp, [(col, round(c,3)) for _,c,col in sorted(cors, reverse=True)[:8]])
            # group mean response for family and st
            for col in ['family','st']:
                if col in rows[0]:
                    groups=collections.defaultdict(list)
                    for r in rows: groups[r[col]].append(float(r[resp]))
                    print('mean_by_'+col, {k: round(statistics.mean(v),3) for k,v in sorted(groups.items())})

print('\\nPHYLO_NESTED')
with zipfile.ZipFile(root/'48306316_ML_Phylo.zip') as z:
    totals=[]
    for name in sorted(z.namelist()):
        if name.endswith('.tar.gz'):
            b=io.BytesIO(z.read(name))
            with tarfile.open(fileobj=b, mode='r:gz') as tf:
                members=tf.getnames()
                counts=[]
                for fn in members:
                    base=fn.split('/')[-1]
                    if base.endswith('.faa') and (base.count('.mafft')==0 or base.endswith('.mafft.trimmed.80.faa') or base.endswith('.mafft.trimmed.80.mc.faa')):
                        try:
                            counts.append((base, tf.extractfile(fn).read().count(b'>')))
                        except Exception: pass
                final=[c for f,c in counts if f.endswith('.mafft.trimmed.80.faa')]
                orig=[c for f,c in counts if f.endswith('.faa') and '.mafft' not in f]
                totals.append((name.replace('.tar.gz',''), len(members), orig[0] if orig else None, final[0] if final else None))
    for row in totals:
        print(row[0], 'files', row[1], 'orig_seq', row[2], 'final_seq', row[3])
    print('families/orders', len(totals), 'orig_total', sum(x[2] or 0 for x in totals), 'final_total', sum(x[3] or 0 for x in totals))
