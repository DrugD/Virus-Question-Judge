/bin/zsh -lc "python - <<'PY'
import tarfile, zipfile, re, statistics, io, collections, math
from pathlib import Path
root=Path('data')

def fasta_stats_from_bytes(data):
    n=0; lengths=[]; headers=[]; seq_len=0; inseq=False
    for line in data.decode('utf-8','ignore').splitlines():
        if line.startswith('>'):
            if inseq: lengths.append(seq_len)
            n+=1; headers.append(line[1:].strip()); seq_len=0; inseq=True
        else:
            seq_len += len(line.strip())
    if inseq: lengths.append(seq_len)
    return n, lengths, headers[:5]

print('VIRAL_CONTIGS')
with tarfile.open(root/'43059583_BtCN-Virome_full_spectrum_contigs.tar.gz','r:gz') as tf:
    m=tf.getmember('BtCN-Virome_full_spectrum.fna')
    data=tf.extractfile(m).read()
    n,L,H=fasta_stats_from_bytes(data)
    print('entries', n, 'total_bp', sum(L), 'min', min(L), 'median', statistics.median(L), 'mean', round(statistics.mean(L),1), 'max', max(L))
    print('len_ge_1000', sum(x>=1000 for x in L), 'len_ge_5000', sum(x>=5000 for x in L), 'len_ge_10000', sum(x>=10000 for x in L))
    print('headers', H)
    covs=[]
    for h in re.findall(r'"'^>(.*)'"', data.decode('utf-8','ignore'), re.M):
        m=re.search(r'_cov_([0-9.]+)', h)
        if m: covs.append(float(m.group(1)))
    print('coverage_n', len(covs), 'cov_median', round(statistics.median(covs),3), 'cov_mean', round(statistics.mean(covs),3), 'cov_max', round(max(covs),3), 'cov_ge_100', sum(c>=100 for c in covs))

print('\\nMARKER_FASTAS')
with tarfile.open(root/'43059592_CytB-COI-ITS.tar.gz','r:gz') as tf:
    for m in tf.getmembers():
        if m.isfile() and m.name.lower().endswith(('.fna','.fasta','.fas')):
            data=tf.extractfile(m).read()
            n,L,H=fasta_stats_from_bytes(data)
