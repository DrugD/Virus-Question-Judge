import zipfile, xml.etree.ElementTree as ET, re
from pathlib import Path
xlsx=Path('data/43059586_RdRp_motif_collection.xlsx')
ns={'a':'http://schemas.openxmlformats.org/spreadsheetml/2006/main'}
with zipfile.ZipFile(xlsx) as z:
    ss=[]
    root=ET.fromstring(z.read('xl/sharedStrings.xml'))
    for si in root.findall('a:si', ns):
        parts=[]
        for t in si.findall('.//a:t', ns): parts.append(t.text or '')
        ss.append(''.join(parts))
    sheet=ET.fromstring(z.read('xl/worksheets/sheet1.xml'))
    rows=[]
    for row in sheet.findall('.//a:sheetData/a:row', ns):
        vals=[]
        for c in row.findall('a:c', ns):
            ref=c.attrib.get('r','')
            col=''.join(ch for ch in ref if ch.isalpha())
            v=c.find('a:v', ns)
            if v is None: val=''
            elif c.attrib.get('t')=='s': val=ss[int(v.text)]
            else: val=v.text or ''
            vals.append((col,val))
        rows.append(vals)
    def colnum(col):
        n=0
        for ch in col: n=n*26+ord(ch)-64
        return n
    table=[]
    maxc=max((colnum(c) for row in rows for c,v in row), default=0)
    for row in rows:
        arr=['']*maxc
        for c,v in row: arr[colnum(c)-1]=v
        table.append(arr)
    print('rows', len(table), 'cols', maxc)
    for arr in table[:30]:
        print('\\t'.join(arr))
