print('\\nMETADATA')
import csv
with zipfile.ZipFile(root/'45561465_Meta_data_for_ecological_modeling.zip') as z:
    for name in z.namelist():
        if name.endswith('.txt'):
            text=z.read(name).decode('utf-8-sig')
            rows=list(csv.DictReader(io.StringIO(text), delimiter='\\t'))
            print(name, 'rows', len(rows), 'cols', rows[0].keys() if rows else [])
            if rows:
                fam=collections.Counter(r['family'] for r in rows)
                st=collections.Counter(r['st'] for r in rows)
                tvs=[float(r['tvs']) for r in rows if r.get('tvs')]
                print('  family', dict(fam), 'st', dict(st), 'tvs_mean', round(statistics.mean(tvs),3), 'median', round(statistics.median(tvs),3), 'range', (round(min(tvs),3), round(max(tvs),3)))
                # correlations with tvs for numeric predictors
                nums=['srs10','H10','hurs10','pet10','pr10','rsds10','sfcwind10','tas10','vpd10','sp']
                cors=[]
                for col in nums:
                    xs=[float(r[col]) for r in rows if r.get(col) and r.get('tvs')]
                    ys=[float(r['tvs']) for r in rows if r.get(col) and r.get('tvs')]
                    if len(xs)>1 and statistics.pstdev(xs)>0 and statistics.pstdev(ys)>0:
                        mx=statistics.mean(xs); my=statistics.mean(ys)
                        corr=sum((x-mx)*(y-my) for x,y in zip(xs,ys))/(len(xs)*statistics.pstdev(xs)*statistics.pstdev(ys))
                        cors.append((abs(corr), corr, col))
                print('  top_abs_corr', [(col, round(c,3)) for _,c,col in sorted(cors, reverse=True)[:5]])

print('\\nPHYLO_NESTED')
with zipfile.ZipFile(root/'48306316_ML_Phylo.zip') as z:
