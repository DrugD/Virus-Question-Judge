from openpyxl import load_workbook
from collections import Counter, defaultdict
from statistics import median, mean
import re
ws=load_workbook('data/41586_2018_12_MOESM3_ESM.xlsx', read_only=True, data_only=True).active
rows=list(ws.iter_rows(values_only=True)); h=list(rows[0])
vir=[]
for row in rows[1:]:
    d={h[i]:row[i] for i in range(len(h)) if h[i] is not None}
    if isinstance(d.get('Order'), int): vir.append(d)
# parse identity percent last parenthetical or all
ids=[]; no=[]
for r in vir:
    s=str(r.get('Blastx hits on known viruses (blast amino acid identity)') or '')
    m=re.findall(r'\\((\\d+(?:\\.\\d+)?)%\\)', s)
    if m: ids.append(float(m[-1]))
    else: no.append((r['Virus Name'],s))
print('identity n',len(ids),'min median mean max',min(ids),median(ids),mean(ids),max(ids))
for thresh in [30,40,50,70,90,99]: print('<=',thresh,sum(x<=thresh for x in ids))
# by classification median identities count low
class_ids=defaultdict(list)
for r in vir:
    s=str(r.get('Blastx hits on known viruses (blast amino acid identity)') or '')
    m=re.findall(r'\\((\\d+(?:\\.\\d+)?)%\\)', s)
    if m: class_ids[r['Classification']].append(float(m[-1]))
print('low identity classifications n>=4')
for cl, vals in sorted(class_ids.items(), key=lambda kv: median(kv[1])):
    if len(vals)>=4:
        print(cl,'n',len(vals),'median',median(vals),'<=40',sum(x<=40 for x in vals))
# tissue x host class counts
mat=defaultdict(Counter)
def split(v): return [x.strip() for x in str(v).split(',') if x and x.strip()]
for r in vir:
    for t in split(r['Tissue']): mat[r['Host class']][t]+=1
print('\\ntissue by host class')
for cl,c in mat.items(): print(cl,c)
# family across host classes
fam_classes=defaultdict(set); fam_n=Counter()
for r in vir:
    fam_classes[r['Classification']].add(r['Host class']); fam_n[r['Classification']]+=1
print('\\nclassifications spanning host classes')
for fam, classes in sorted(fam_classes.items(), key=lambda kv:(-len(kv[1]), -fam_n[kv[0]]))[:20]: print(fam, 'n', fam_n[fam], 'classes', sorted(classes, key=str))
# host classes per virus name?
name_classes=defaultdict(set)
for r in vir: name_classes[r['Virus Name']].add(r['Host class'])
print('virus names across >1 host class', [(n,sorted(c, key=str)) for n,c in name_classes.items() if len(c)>1][:20], 'count', sum(1 for c in name_classes.values() if len(c)>1))
