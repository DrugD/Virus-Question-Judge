from openpyxl import load_workbook
from collections import Counter, defaultdict
from statistics import median, mean
import math

def load(path):
    ws=load_workbook(path, read_only=True, data_only=True).active
    rows=list(ws.iter_rows(values_only=True))
    h=list(rows[0])
    return [{h[i]: row[i] if i < len(row) else None for i in range(len(h)) if h[i] is not None} for row in rows[1:]]
lib=[r for r in load('data/41586_2018_12_MOESM2_ESM.xlsx') if r.get('Library Code')]
vir=[r for r in load('data/41586_2018_12_MOESM3_ESM.xlsx') if isinstance(r.get('Order'), int)]
def split(v):
    if v is None: return []
    return [x.strip() for x in str(v).split(',') if x and x.strip()]
def norm(v):
    if v is None: return None
    s=str(v).strip()
    return None if s.upper() in {'N/A','NA',''} else s
print('VALID LIB rows',len(lib))
print('VALID VIR rows',len(vir))
bps=[float(r['Data (bp)']) for r in lib]
print('Data bp total Gb',sum(bps)/1e9,'medianGb',median(bps)/1e9,'minGb',min(bps)/1e9,'maxGb',max(bps)/1e9)
print('organs',Counter(r['Host Organ'] for r in lib).most_common())
print('organ expanded',Counter(x.strip().title() for r in lib for x in str(r['Host Organ']).replace('and',',').split(',') if r['Host Organ'] and x.strip()).most_common())
print('classes lib',Counter(x for r in lib for x in split(r['Host Class'])).most_common())
print('orders lib top',Counter(x for r in lib for x in split(r['Host Orders'])).most_common(10))
print('locations top',Counter(x for r in lib for x in split(r['Locations'])).most_common(12))
print('host species lib unique',len(set(x for r in lib for x in split(r['Host Species']))))
print('accessions lib',len(set(r['Library Accession'] for r in lib)))
print('\\nVirus unique names',len(set(r['Virus Name'] for r in vir)),'accessions',len(set(r['Accession'] for r in vir)),'classes',len(set(r['Classification'] for r in vir)))
print('classification top',Counter(r['Classification'] for r in vir).most_common(15))
print('host classes vir',Counter(r['Host class'] for r in vir).most_common())
print('host order top',Counter(r['Host order'] for r in vir).most_common(15))
print('tissues expanded',Counter(t for r in vir for t in split(r['Tissue'])).most_common())
print('notes',Counter(r['Note'] for r in vir).most_common())
print('host species vir unique excl NA',len(set(norm(r['Host species']) for r in vir if norm(r['Host species']))))
lengths=[float(r['Length']) for r in vir if isinstance(r.get('Length'),(int,float))]
reads=[float(r['% reads *']) for r in vir if isinstance(r.get('% reads *'),(int,float))]
covs=[float(r['Coverage *']) for r in vir if isinstance(r.get('Coverage *'),(int,float))]
print('length min med mean max',min(lengths),median(lengths),mean(lengths),max(lengths),'n',len(lengths))
print('reads min med mean max',min(reads),median(reads),mean(reads),max(reads),'n',len(reads))
print('cov min med mean max',min(covs),median(covs),mean(covs),max(covs),'n',len(covs))
print('cov>=100',sum(x>=100 for x in covs),'cov>=1000',sum(x>=1000 for x in covs),'reads>=0.01',sum(x>=0.01 for x in reads),'reads>=0.1',sum(x>=0.1 for x in reads))
code_set=set(r['Library Code'] for r in lib)
vir_codes=Counter(c for r in vir for c in split(r['Library']))
print('virus code count',len(vir_codes),'matched',sum(c in code_set for c in vir_codes),'unmatched',[c for c in vir_codes if c not in code_set])
print('library positive',sum(c in vir_codes for c in code_set),'of',len(code_set))
print('top library virus',vir_codes.most_common(12))
# unique virus names by groups
for group, expanded in [('Host class',False),('Host order',False),('Tissue',True),('Classification',False)]:
    d=defaultdict(set)
    for r in vir:
        vals=split(r[group]) if expanded else [r[group]]
        for v in vals: d[v].add(r['Virus Name'])
    print('unique names by',group, sorted(((k,len(v)) for k,v in d.items()), key=lambda x:-x[1])[:10])
# log corr
pairs=[(float(r['% reads *']), float(r['Coverage *'])) for r in vir if isinstance(r.get('% reads *'),(int,float)) and isinstance(r.get('Coverage *'),(int,float)) and r['% reads *']>0 and r['Coverage *']>0]
xs=[math.log10(a) for a,b in pairs]; ys=[math.log10(b) for a,b in pairs]
mx,my=mean(xs),mean(ys)
print('corr log reads cov',sum((x-mx)*(y-my) for x,y in zip(xs,ys))/math.sqrt(sum((x-mx)**2 for x in xs)*sum((y-my)**2 for y in ys)),len(pairs))
# classes across library sampling vs virus yield per library matched? detection counts grouped by library host class
lib_by_code={r['Library Code']:r for r in lib}
yield_by_class=Counter()
lib_count_by_class=Counter()
for c,r in lib_by_code.items():
    for cl in split(r['Host Class']):
        lib_count_by_class[cl]+=1
        yield_by_class[cl]+=vir_codes.get(c,0)
print('virus records per library class matched')
for cl,n in lib_count_by_class.most_common():
    print(cl,'libraries',n,'virus_records',yield_by_class[cl], 'per_lib', yield_by_class[cl]/n)
