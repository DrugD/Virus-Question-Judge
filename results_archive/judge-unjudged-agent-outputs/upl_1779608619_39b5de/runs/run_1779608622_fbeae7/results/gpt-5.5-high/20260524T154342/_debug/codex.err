/bin/zsh -lc "python3 - <<'PY'
from openpyxl import load_workbook
from collections import Counter, defaultdict
from statistics import median, mean
import re, math

def rows(path):
    ws=load_workbook(path, read_only=True, data_only=True).active
    it=ws.iter_rows(values_only=True)
    headers=list(next(it))
    out=[]
    for row in it:
        d={headers[i]: row[i] if i < len(row) else None for i in range(len(headers)) if headers[i] is not None}
        if any(v not in (None,'') for v in d.values()): out.append(d)
    return headers, out
h2, lib=rows('data/41586_2018_12_MOESM2_ESM.xlsx')
h3, vir=rows('data/41586_2018_12_MOESM3_ESM.xlsx')
print('LIB rows',len(lib),'headers',h2)
print('VIR rows',len(vir),'headers',[h for h in h3 if h])

def split(v):
    if v is None: return []
    return [x.strip() for x in str(v).split(',') if x and x.strip()]

def norm_na(v):
    if v is None: return None
    s=str(v).strip()
    if s.upper() in {'N/A','NA',''}: return None
    return s

print('\\nLibrary data bp')
bps=[float(r['Data (bp)']) for r in lib if r.get('Data (bp)') is not None]
print('sum',sum(bps),'Gb',sum(bps)/1e9,'medianGb',median(bps)/1e9,'minGb',min(bps)/1e9,'maxGb',max(bps)/1e9)
print('organ counts',Counter(r['Host Organ'] for r in lib).most_common())
cls=Counter(x for r in lib for x in split(r['Host Class']))
print('host class mentions library',cls)
orders=Counter(x for r in lib for x in split(r['Host Orders']))
print('top orders library',orders.most_common(12))
locs=Counter(x for r in lib for x in split(r['Locations']))
print('locations',locs.most_common(20))
species=set(x for r in lib for x in split(r['Host Species']))
print('unique host species mention lib',len(species))
print('example species',list(sorted(species))[:10])
print('library codes',len(set(r['Library Code'] for r in lib)))

print('\\nVirus table')
print('records',len(vir),'unique virus names',len(set(r['Virus Name'] for r in vir)),'unique accessions',len(set(r['Accession'] for r in vir)))
print('classifications count',len(set(r['Classification'] for r in vir)))
print('top classifications',Counter(r['Classification'] for r in vir).most_common(20))
print('host class counts',Counter(r['Host class'] for r in vir).most_common())
print('host order top',Counter(r['Host order'] for r in vir).most_common(20))
print('tissue counts',Counter(t for r in vir for t in split(r['Tissue'])).most_common())
print('note counts',Counter(r['Note'] for r in vir).most_common())
print('segment nonempty',sum(1 for r in vir if norm_na(r.get('Segment (protein)'))), Counter(norm_na(r.get('Segment (protein)')) for r in vir if norm_na(r.get('Segment (protein)'))).most_common(20))
