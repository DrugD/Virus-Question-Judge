mx,my=mean(xs),mean(ys)
r=sum((x-mx)*(y-my) for x,y in zip(xs,ys))/math.sqrt(sum((x-mx)**2 for x in xs)*sum((y-my)**2 for y in ys))
print('\\nlog10 %reads vs log10 coverage Pearson r',r,'n',len(pairs))

# Host species count in vir
print('unique host species vir excluding NA',len(set(norm_na(r['Host species']) for r in vir if norm_na(r['Host species']))))
print('top host species vir',Counter(r['Host species'] for r in vir).most_common(20))
