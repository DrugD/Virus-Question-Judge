codex
The internal alignments are amino acid FASTA files and Newick trees, mostly centered on RdRp with a smaller RdRp-versus-structural comparison folder. I’m now computing counts, alignment sizes, tree leaf counts, genome-length distributions, and marker/segment frequencies across all visible data.
exec
/bin/zsh -lc "python3 - <<'PY'
import zipfile, re, json, statistics, math
from collections import Counter, defaultdict
from pathlib import Path
root=Path('/private/tmp/codex-sandboxes/gpt-5.5-high/20260524T132052')
fa=root/'data/5905698_all_virus_genomes.fasta'
zip_path=root/'data/5905695_alignments_and_phylogenies.zip'

def read_fasta_text(text):
    records=[]; h=None; seq=[]
    for line in text.splitlines():
        line=line.strip()
        if not line: continue
        if line.startswith('>'):
            if h is not None:
                records.append((h,''.join(seq)))
            h=line[1:]; seq=[]
        else:
            seq.append(line)
    if h is not None: records.append((h,''.join(seq)))
    return records

# all genomes
text=fa.read_text(errors='replace')
records=read_fasta_text(text)
lengths=[]; header_lengths=[]; groups=Counter(); markers=Counter(); seqs_by_virus=defaultdict(list); places=Counter(); samples=Counter(); hosts=Counter(); accession_like=0
known_groups=set(['Astro-Poty','Birna','Bunya-Arena','Chu-Mono','Hepe-Virga','Hypo','Luteo-Sobemo','Narna-Levi','Nido','Partiti-Picobirna','Permutotetra','Picorna-Calici','Reo','Tombus-Noda','Toti-Chryso','Qinvirus','Weivirus','Yanvirus','Zhaovirus','Negative','Orthomyxo','Tymo'])
known_markers=['RdRp','Glycoprotein','Nucleoprotein','NS','Capsid','VP1','VP2','VP3','VP4','L','S','M','coding']
for h,s in records:
    lengths.append(len(s))
    m=re.search(r'[_-][Ll]en(\\d+)', h)
    if m: header_lengths.append(int(m.group(1)))
    toks=h.split('_')
    # group = known token appearing anywhere, else token[1] fallback
    g=None
    for tok in toks:
        if tok in known_groups:
            g=tok; break
    if g is None:
        # combos in second token generally, or first for lower-case family refs
        g=toks[1] if len(toks)>1 else 'unknown'
    groups[g]+=1
    found=False
    for mk in known_markers:
        if re.search(r'("'^|_)'"'+re.escape(mk)+r'("'$|_)'"', h, flags=re.I):
            markers[mk]+=1; found=True
    if not found:
        markers['unlabeled/complete']+=1
    # crude virus name: between group and marker/len/accession? just remove first ID and len/marker tokens
    # location/host signal from common tokens
    for loc in ['Hubei','Wuhan','Beihai','Wenling','Wenzhou','Shahe','Shayang','Changjiang','Jingmen','Sanxia','Xinzhou','Xingshan','Shuangao','Bole','Changping']:
        if re.search(r'("'^|_)'"'+loc+r'(_|"'$)'"', h, re.I): places[loc]+=1
    for host in ['mosquito','insect','shrimp','crab','spider','leech','nematode','worm','barnacle','fly','tick','ciliate','plant','bat','avian','fish','horsefly','centipede','myriapoda','fluke','lepidoptera','ascaridia','anemone','crustacean','mollusk']:
        if re.search(host, h, re.I): hosts[host]+=1
    if re.search(r'\\b[ANKY]?[A-Z]{1,3}_?\\d{5,}|KM\\d+', h): accession_like+=1

def q(vals):
    vals=sorted(vals)
    def pct(p):
        k=(len(vals)-1)*p; f=math.floor(k); c=math.ceil(k)
        if f==c: return vals[int(k)]
        return vals[f]*(c-k)+vals[c]*(k-f)
    return {\"min\":vals[0],\"p25\":pct(.25),\"median\":pct(.5),\"mean\":sum(vals)/len(vals),\"p75\":pct(.75),\"max\":vals[-1]}

# zip parse all members
zip_stats=[]; alignments=[]; trees=[]; folder_counts=Counter(); name_lengths={}
with zipfile.ZipFile(zip_path) as z:
    names=z.namelist()
    for name in names:
        data=z.read(name)  # reads every file in archive
        txt=data.decode('utf-8', errors='replace')
        folder_counts[name.split('/')[0] if '/' in name else '(root)']+=1
        name_lengths[name]=len(data)
        if name.endswith(('.fas','.fasta')):
            recs=read_fasta_text(txt)
            alens=[len(seq) for _,seq in recs]
            gap_counts=[seq.count('-') for _,seq in recs]
            alignments.append({
                'name':name, 'records':len(recs), 'alignment_length': alens[0] if alens else 0,
                'seq_len_uniform': len(set(alens))==1, 'gap_fraction': sum(gap_counts)/sum(alens) if sum(alens) else 0,
                'sample_headers':[h for h,_ in recs[:3]],
                'labels':[h for h,_ in recs]
            })
        elif name.endswith('.nwk'):
            # leaf labels after '(' or ',' up to : ; robust enough for this corpus
            leaves=re.findall(r'(?<=[(,])(["'^():,;'"\\s]+):', txt)
            branch_lengths=[float(x) for x in re.findall(r':([0-9]+(?:\\.[0-9]+)?(?:[eE][-+]?\\d+)?)', txt)]
            supports=[]
            for x in re.findall(r'\\)([0-9]+(?:\\.[0-9]+)?)', txt):
                try: supports.append(float(x))
                except: pass
            trees.append({
                'name':name, 'leaves':len(leaves), 'unique_leaves':len(set(leaves)),
                'branch_length_count':len(branch_lengths), 'mean_branch_length':statistics.mean(branch_lengths) if branch_lengths else None,
                'max_branch_length':max(branch_lengths) if branch_lengths else None,
                'support_count':len(supports), 'mean_support':statistics.mean(supports) if supports else None,
                'leaf_sample':leaves[:5]
            })

# pair alignments and trees by basename prefix similarity
# summarize roots
rd_align=[a for a in alignments if 'RdRp' in Path(a['name']).name]
struct_align=[a for a in alignments if 'Structure' in Path(a['name']).name]
small_folder=[a for a in alignments if a['name'].startswith('RdRp_versus_structural/')]
root_align=[a for a in alignments if '/' not in a['name']]

print('ALL_GENOMES_RECORDS', len(records))
print('ALL_GENOMES_LEN_STATS', q(lengths))
print('HEADER_LEN_MISMATCHES', sum(1 for h,s in records if re.search(r'[_-][Ll]en(\\d+)', h) and int(re.search(r'[_-][Ll]en(\\d+)', h).group(1)) "'!= len(s)))
print('"'TOP_GROUPS', groups.most_common(20))
print('MARKERS', markers.most_common())
print('TOP_PLACES', places.most_common(15))
print('TOP_HOSTS', hosts.most_common(20))
print('ACCESSION_LIKE_HEADERS', accession_like)
print('ZIP_FILES', len(name_lengths), 'folders', folder_counts)
print('ALIGNMENT_COUNT', len(alignments), 'TREE_COUNT', len(trees))
print('ROOT_ALIGNMENTS', len(root_align), 'RDRP_ROOT_ALIGNMENTS', len([a for a in root_align if \"RdRp\" in a['name']]))
print('STRUCTURE_FOLDER_ALIGNMENTS', len(small_folder), 'STRUCT_ALIGNMENTS', len(struct_align), 'RDRP_SMALL_ALIGNMENTS', len([a for a in small_folder if \"RdRp\" in a['name']]))
print('ALIGN_RECORD_STATS', q([a['records'] for a in alignments]))
print('ALIGN_LEN_STATS', q([a['alignment_length'] for a in alignments]))
print('ALIGN_GAP_FRAC_STATS', q([a['gap_fraction'] for a in alignments]))
print('LARGEST_ALIGNMENTS')
for a in sorted(alignments, key=lambda x:x['records'], reverse=True)[:10]:
    print(a['name'], a['records'], a['alignment_length'], round(a['gap_fraction'],3), a['sample_headers'][:1])
print('TREE_LEAF_STATS', q([t['leaves'] for t in trees]))
print('LARGEST_TREES')
for t in sorted(trees, key=lambda x:x['leaves'], reverse=True)[:10]:
    print(t['name'], t['leaves'], 'meanBL', round(t['mean_branch_length'] or 0,3), 'support', round(t['mean_support'] or 0,3), t['leaf_sample'][:2])
print('SMALL RDRP VS STRUCT')
for a in sorted(small_folder, key=lambda x:x['name']):
    print(a['name'], a['records'], a['alignment_length'], round(a['gap_fraction'],3), a['sample_headers'][:2])

# compare labels between matching small RdRp and Structure alignments via tree? collect names per basename
# Save machine-readable stats outside cwd? no need.
