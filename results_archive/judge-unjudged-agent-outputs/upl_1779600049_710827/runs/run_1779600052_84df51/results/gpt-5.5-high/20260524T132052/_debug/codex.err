import zipfile,re,math,statistics
from collections import Counter,defaultdict
from pathlib import Path
root=Path('/private/tmp/codex-sandboxes/gpt-5.5-high/20260524T132052')
zip_path=root/'data/5905695_alignments_and_phylogenies.zip'

def read_fasta_text(text):
    records=[]; h=None; seq=[]
    for line in text.splitlines():
        line=line.strip()
        if not line: continue
        if line.startswith('>'):
            if h is not None: records.append((h,''.join(seq)))
            h=line[1:]; seq=[]
        else: seq.append(line)
    if h is not None: records.append((h,''.join(seq)))
    return records

with zipfile.ZipFile(zip_path) as z:
    summaries=[]
    total_root=novel_root=ref_root=0
    group_new=Counter(); group_ref=Counter()
    for name in z.namelist():
        if not name.endswith('.fas') or '/' in name: continue
        recs=read_fasta_text(z.read(name).decode('utf-8','replace'))
        novel=sum(1 for h,s in recs if re.search(r'[_-][Ll]en\\d+',h))
        refs=len(recs)-novel
        total_root += len(recs); novel_root += novel; ref_root += refs
        summaries.append((name,len(recs),novel,refs))
        group=name.replace('_RdRp_trimmed_alignment.fas','').replace('_RdRp_trimmed_alignment','')
        group_new[group]=novel; group_ref[group]=refs
    print('ROOT_RDRP_TOTAL_RECORDS',total_root,'NOVEL_LEN_TAGGED',novel_root,'REFERENCE_OR_UNTAGGED',ref_root)
    print('ROOT_RDRP_TOP_NOVEL')
    for group,n in group_new.most_common(): print(group,n,'refs',group_ref[group])
