/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from collections import Counter,defaultdict
root=Path('data')
files=sorted(root.iterdir())

def read_fasta(path):
    recs=[]; h=None; seq=[]
    with path.open() as f:
        for line in f:
            line=line.strip()
            if not line: continue
            if line.startswith('>'):
                if h is not None:
                    recs.append((h,''.join(seq)))
                h=line[1:]; seq=[]
            else:
                seq.append(line)
        if h is not None:
            recs.append((h,''.join(seq)))
    return recs

def nongap_len(s):
    return sum(1 for c in s if c not in '-.')

def is_hirai(h):
    return h.startswith('Hirai') or h.startswith('contig_') or 'Hirai' in h

def fam_from_file(p):
    n=p.name
    if '_alignment' in n:
        return n.split('_')[-2] if n.split('_')[-1]=='alignment.fas' else n
    return n

allrecs=[]
print('FILE_SUMMARY')
for p in files:
    recs=read_fasta(p)
    allrecs += [(p.name,h,s) for h,s in recs]
    lens=[nongap_len(s) for h,s in recs]
    raw=[len(s) for h,s in recs]
    hir=sum(is_hirai(h) for h,s in recs)
    dash=sum(s.count('-') for h,s in recs)
    chars=Counter(''.join(s for h,s in recs).upper())
    alphabet='nt' if sum(chars[c] for c in 'ACGTUN') > sum(chars[c] for c in 'EFILPQZX*')*2 else 'aa/alignment'
    print(p.name, 'records',len(recs),'hirai',hir,'raw_len_range', (min(raw), max(raw)), 'nongap_range',(min(lens),max(lens)),'mean_nongap',round(sum(lens)/len(lens),1),'dash',dash,'alphabet',alphabet)

print('\\nHIRAI_IN_ALIGNMENTS')
for p in files:
    if 'alignment' in p.name:
        recs=read_fasta(p)
        print(p.name)
        for h,s in recs:
            if is_hirai(h): print(' ',h,'len',nongap_len(s))

# classify Hirai_Contigs_RdRp headers
rd=read_fasta(root/'16945969_31356130_Hirai_Contigs_RdRp.fas')
class_counts=Counter()
status_counts=Counter()
for h,s in rd:
    parts=h.split('_')
    # h contig_2542_Chu-like_partial or contig_2_LC651642_Picorna-like_complete
    status=h.rsplit('_',1)[-1]
    status_counts[status]+=1
    body=h[len('contig_'):]
    toks=body.split('_')
    # remove id first
    toks=toks[1:]
    if toks and (toks[0].startswith('LC') or toks[0].startswith('NC') or toks[0].startswith('AB')):
        toks=toks[1:]
    label='_'.join(toks[:-1]) if toks and toks[-1] in ('partial','complete') else '_'.join(toks)
    class_counts[label]+=1
print('\\nRDRP_CLASS_COUNTS')
for k,v in class_counts.most_common(): print(k,v)
print('status',status_counts)

# nohit stats
no=read_fasta(root/'16958869_31373884_Possible_virus_contigs.fas')
print('\\nNOHIT_LENGTHS', sorted(nongap_len(s) for h,s in no))
# nuccore gene labels
nu=read_fasta(root/'nuccore_reported_viral_sequences.fasta')
gene_counts=Counter()
for h,s in nu:
    desc=h.lower()
    if 'polyprotein' in desc: gene='polyprotein'
    elif 'capsid' in desc: gene='capsid'
    elif 'rdrp' in desc: gene='RdRp'
    elif 'hypothetical' in desc: gene='hypothetical protein'
    else: gene='other'
    gene_counts[gene]+=1
print('\\nNUCCORE_GENE_COUNTS', gene_counts)
for h,s in nu: print(h,'len',nongap_len(s))

# overlap reported LC in RdRp contigs
lc_in_rd=[]
for h,s in rd:
    for token in h.replace('_',' ').split():
        if token.startswith('LC'):
            lc_in_rd.append((token,h,nongap_len(s)))
print('\\nLC_IN_RDRP',lc_in_rd)

# totals
print('\\nTOTAL records',len(allrecs), 'hirai-like', sum(is_hirai(h) for _,h,_ in allrecs))
# alignment family count with hirai share
