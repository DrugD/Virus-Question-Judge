/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from collections import Counter
root=Path('data')

def read_fasta(path):
    recs=[]; h=None; seq=[]
    for line in path.read_text().splitlines():
        line=line.strip()
        if not line: continue
        if line.startswith('>'):
            if h is not None: recs.append((h,''.join(seq)))
            h=line[1:]; seq=[]
        else: seq.append(line.upper())
    if h is not None: recs.append((h,''.join(seq)))
    return recs

def is_hirai(h):
    return h.startswith('Hirai') or h.startswith('contig_') or 'Hirai' in h

def pid(a,b):
    overlap=match=0
    for x,y in zip(a,b):
        if x in '-.' or y in '-.': continue
        overlap+=1
        if x==y: match+=1
    return (100*match/overlap if overlap else 0, overlap)

print('NEAREST_REFERENCE_BY_ALIGNMENT')
for p in sorted(root.glob('*alignment.fas')):
    recs=read_fasta(p)
    refs=[r for r in recs if not is_hirai(r[0])]
    hir=[r for r in recs if is_hirai(r[0])]
    vals=[]
    print('\\n'+p.name, 'Hirai',len(hir),'Refs',len(refs))
    for h,s in hir:
        best=max(((pid(s,rs)[0], pid(s,rs)[1], rh) for rh,rs in refs), default=(0,0,''))
        vals.append(best[0])
        print(f'{h}: best_pid={best[0]:.1f} overlap={best[1]} ref={best[2][:80]}')
    if vals:
        print('family best_pid range/mean', f'{min(vals):.1f}-{max(vals):.1f}', f'{sum(vals)/len(vals):.1f}')
