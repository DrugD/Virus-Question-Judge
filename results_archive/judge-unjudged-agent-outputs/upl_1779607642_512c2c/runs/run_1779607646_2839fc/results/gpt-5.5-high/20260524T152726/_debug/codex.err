from collections import Counter, defaultdict
from statistics import mean, median
from pathlib import Path
import re, math
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]
header=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if header is not None:
            records.append((header,''.join(seq).upper()))
        header=line[1:].strip(); seq=[]
    else:
        seq.append(line.strip())
if header is not None:
    records.append((header,''.join(seq).upper()))
print('records', len(records))
lengths=[len(s) for _,s in records]
print('total_bases', sum(lengths))
print('len_min_median_mean_max', min(lengths), median(lengths), round(mean(lengths),1), max(lengths))
print('len_quartiles', sorted(lengths)[len(lengths)//4], sorted(lengths)[len(lengths)//2], sorted(lengths)[3*len(lengths)//4])
print('gc_mean_min_max', round(mean([(s.count('G')+s.count('C'))/len(s)*100 for _,s in records]),2), round(min([(s.count('G')+s.count('C'))/len(s)*100 for _,s in records]),2), round(max([(s.count('G')+s.count('C'))/len(s)*100 for _,s in records]),2))
print('ambiguous_N_records', sum('N' in s for _,s in records), 'N_total', sum(s.count('N') for _,s in records))
# parse header
places=[]; groups=[]; types=[]; tigmic=[]; names=[]; access=[]
parse_fail=[]
for h,s in records:
    access.append(h.split()[0])
    m=re.match(r'(["'^ ]+) MAG: (.*?) isolate TIGMIC ('"\\d+) (genomic|cRNA) sequence"'$'"', h)
    if not m:
        parse_fail.append(h); continue
    acc, desc, iso, typ=m.groups()
    types.append(typ); tigmic.append(int(iso))
    # desc examples: Nanning Botou tick virus 1, Chuzhou tick virus 1 (no group)
    toks=desc.split()
    place=toks[0]
    places.append(place)
    names.append(desc)
    # group = token before tick if len >? e.g 'Botou tick'; if just '<place> tick virus', group='unclassified'
    ti=toks.index('tick')
    group=' '.join(toks[1:ti]) if ti>1 else '(none)'
    groups.append(group)
print('parse_fail', len(parse_fail))
print('type_counts', Counter(types))
print('unique_places', len(set(places)))
print('top_places', Counter(places).most_common(15))
print('unique_groups', len(set(groups)))
print('top_groups', Counter(groups).most_common(20))
print('isolate_counts_tigmic_summary', min(tigmic), median(tigmic), max(tigmic), 'gt1', sum(x>1 for x in tigmic), 'ge10', sum(x>=10 for x in tigmic))
print('top_tigmic', sorted(zip(tigmic,names,access,lengths), reverse=True)[:20])
# records by group type length
bygroup=defaultdict(list); byplace=defaultdict(list)
for (h,s),g,pl,typ in zip(records,groups,places,types):
    bygroup[g].append((h,s,typ))
    byplace[pl].append((h,s,typ))
print('\\nGROUP_STATS top by count: group count medlen meangc genomic cRNA unique_places')
for g,c in Counter(groups).most_common(30):
    rec=bygroup[g]
    lens=[len(s) for _,s,_ in rec]
    gcs=[(s.count('G')+s.count('C'))/len(s)*100 for _,s,_ in rec]
    tc=Counter(t for *_,t in rec)
    upl=len(set(re.match(r'["'^ ]+ MAG: ([''^ ]+)'"', h).group(1) for h,_,_ in rec))
    print(g, c, int(median(lens)), round(mean(gcs),1), tc.get('genomic',0), tc.get('cRNA',0), upl)
# unique species names vs places?
print('\\nVirus names repeated across places?')
# remove place prefix from desc? e.g Botou tick virus 1 repeated with prefixes? Maybe virus type is after place
familynum=Counter()
for desc in names:
    toks=desc.split()
    try: ti=toks.index('tick')
    except: continue
    # clade name from token(s) before tick + virus + number
    clade=' '.join(toks[1:])
    familynum[clade]+=1
print('unique_clade_names', len(familynum), 'repeated_clade_names', sum(1 for v in familynum.values() if v>1))
print(familynum.most_common(20))
# accessions prefixes count
print('accession_prefixes', Counter(re.match(r'[A-Z]+', a).group(0) for a in access))
# seq type by group cRNA counts
print('\\ncRNA groups', Counter(g for g,t in zip(groups,types) if t=='cRNA').most_common())
print('genomic groups top', Counter(g for g,t in zip(groups,types) if t=='genomic').most_common(20))
# min/max records
print('\\nshortest')
for l,h in sorted((len(s),h) for h,s in records)[:10]: print(l,h)
print('\\nlongest')
for l,h in sorted((len(s),h) for h,s in records)[-10:]: print(l,h)
# locations by groups richness
loc_groups=defaultdict(set)
for pl,g in zip(places,groups): loc_groups[pl].add(g)
print('\\ntop location group richness', sorted(((len(v),pl,Counter([g for p,g in zip(places,groups) if p==pl]).most_common(5)) for pl,v in loc_groups.items()), reverse=True)[:20])
# exact duplicate seqs count
seq_counter=Counter(s for _,s in records)
print('duplicate_sequences groups', sum(1 for v in seq_counter.values() if v>1), 'records_in_dups', sum(v for v in seq_counter.values() if v>1))
