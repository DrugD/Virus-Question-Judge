/bin/zsh -lc "python3 - <<'PY'
from collections import Counter, defaultdict
from statistics import mean, median
from pathlib import Path
import re
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]; h=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if h is not None: records.append((h,''.join(seq).upper()))
        h=line[1:].strip(); seq=[]
    else: seq.append(line.strip())
if h: records.append((h,''.join(seq).upper()))
pat=re.compile(r'"'^(?P<acc>'"\\S+) MAG(?: UNVERIFIED)?: (?P<taxon>.+?) isolate TIGMIC[ _](?P<iso>\\d+)\\b(?P<rest>.*)"'$'"')
fail=[]; parsed=[]
for h,s in records:
    m=pat.match(h)
    if not m: fail.append(h); continue
    d=m.groupdict(); d['header']=h; d['len']=len(s); d['gc']=(s.count('G')+s.count('C'))/len(s)*100; parsed.append(d)
print('parsed',len(parsed),'fail',len(fail))
if fail:
    print('fails sample'); print('\\n'.join(fail[:20]))
print('unique_taxa', len(set(d['taxon'] for d in parsed)))
print('top_taxa')
for x in Counter(d['taxon'] for d in parsed).most_common(30): print(x)
print('\\nrest categories top')
rest_cat=[]
for d in parsed:
    r=d['rest'].strip(' ,')
    if 'complete genome' in r: c='complete genome'
    elif 'complete cds' in r: c='complete cds'
    elif 'partial cds' in r: c='partial cds'
    elif 'genomic sequence' in r: c='genomic sequence'
    elif 'cRNA sequence' in r: c='cRNA sequence'
    elif 'complete sequence' in r: c='complete sequence'
    else: c=r or '(none)'
    rest_cat.append(c)
print(Counter(rest_cat).most_common(20))
print('partial records', sum('partial' in d['rest'] for d in parsed))
print('complete records', sum('complete' in d['rest'] for d in parsed))
print('UNVERIFIED', sum('UNVERIFIED' in d['header'] for d in parsed))
print('sp taxa records', sum(' sp.' in d['taxon'] or d['taxon'].endswith(' sp') for d in parsed), 'unique', len(set(d['taxon'] for d in parsed if ' sp.' in d['taxon'] or d['taxon'].endswith(' sp'))))
# grouping: if taxon like 'Flaviviridae sp.' group family; if first block place+... above maybe group after location, else family/genus first word
family_like=Counter()
for d in parsed:
    tax=d['taxon']
    if ' tick virus' in tax:
        toks=tax.split()
        if toks[1]=='tick': group='unqualified tick virus'
        else: group=toks[1] # likely location qualifier then clade abbreviation
    elif tax.endswith(' sp.'):
        group=tax.replace(' sp.','')
    else:
        group=tax.split()[0]
    family_like[group]+=1
print('\\ncoarse_group top 50')
for x in family_like.most_common(50): print(x)
# accession by prefix, ranges
print('\\naccession prefixes',Counter(re.match(r'[A-Z]+',d['acc']).group() for d in parsed))
# isolate nums, unique isolate IDs? counts by isolate number? (TIGMIC number is sample id maybe)
iso_nums=[int(d['iso']) for d in parsed]
print('iso number min med max unique',min(iso_nums),median(iso_nums),max(iso_nums),len(set(iso_nums)))
print('top isolate ids by records',Counter(iso_nums).most_common(20))
# length bins
