/bin/zsh -lc "python3 - <<'PY'
import tarfile, zipfile, io, re, csv, statistics, math
from pathlib import Path
from collections import Counter, defaultdict
from xml.etree import ElementTree as ET

root=Path('data')

def fasta_iter_text(fh):
    name=None; parts=[]
    for raw in fh:
        if isinstance(raw, bytes): raw=raw.decode('utf-8','replace')
        line=raw.strip()
        if not line: continue
        if line.startswith('>'):
            if name is not None:
                yield name, ''.join(parts)
            name=line[1:]
            parts=[]
        else:
            parts.append(line)
    if name is not None:
        yield name, ''.join(parts)

def summarize_lengths(lengths):
    if not lengths: return {}
    s=sorted(lengths)
    return {'n':len(s),'min':s[0],'median':s[len(s)//2] if len(s)%2 else (s[len(s)//2-1]+s[len(s)//2])/2,'mean':sum(s)/len(s),'max':s[-1],'total':sum(s)}

# BtCN contigs
contig_stats={}
with tarfile.open(root/'43059583_BtCN-Virome_full_spectrum_contigs.tar.gz','r:gz') as tar:
    m=tar.getmember('BtCN-Virome_full_spectrum.fna')
    f=tar.extractfile(m)
    lengths=[]; covs=[]; pools=Counter(); top=[]
    for h,seq in fasta_iter_text(f):
        L=len(seq); lengths.append(L)
        pool=h.split('|')[0]
        pools[pool]+=1
        mc=re.search(r'_cov_([0-9.]+)', h)
        if mc: covs.append(float(mc.group(1)))
        top.append((L,h))
    top=sorted(top, reverse=True)[:10]
    contig_stats={'lengths':summarize_lengths(lengths),'pools_n':len(pools),'top_pools':pools.most_common(10),'cov_n':len(covs),'cov_min':min(covs),'cov_med':statistics.median(covs),'cov_mean':statistics.mean(covs),'cov_max':max(covs),'top_contigs':top[:5]}

# Marker FASTAs in CytB-COI-ITS tar
marker_stats={}
with tarfile.open(root/'43059592_CytB-COI-ITS.tar.gz','r:gz') as tar:
    for m in tar.getmembers():
        if m.isfile() and m.name.lower().endswith(('.fna','.fasta','.fas')):
            f=tar.extractfile(m)
            lengths=[]; first=[]
            for h,seq in fasta_iter_text(f):
                lengths.append(len(seq))
                if len(first)<3: first.append(h[:180])
            marker_stats[m.name]={'lengths':summarize_lengths(lengths),'first_headers':first}

# Excel values minimal xlsx parser/shared strings
# openpyxl already available easier
try:
    import openpyxl
    wb=openpyxl.load_workbook(root/'43059586_RdRp_motif_collection.xlsx', read_only=True, data_only=True)
    ws=wb[wb.sheetnames[0]]
    rows=list(ws.iter_rows(values_only=True))
    motif_stats={'sheetnames':wb.sheetnames,'n_rows':len(rows),'n_cols':max(len(r) for r in rows),'headers':[str(x) if x is not None else '' for x in rows[0]],'motif_rows':[r[0] for r in rows[1:12] if r and r[0]],'nonempty_cells':sum(1 for r in rows for v in r if v not in (None,''))}
except Exception as e:
    motif_stats={'error':repr(e)}

# Metadata zip parse tab-delimited
meta_stats={}
all_rows=[]
with zipfile.ZipFile(root/'45561465_Meta_data_for_ecological_modeling.zip') as z:
    for n in z.namelist():
        if n.endswith('.txt'):
            txt=z.read(n).decode('utf-8-sig')
            rdr=csv.DictReader(io.StringIO(txt), delimiter='\\t')
            rows=list(rdr)
            for r in rows: r['_file']=Path(n).name
            all_rows.extend(rows)
            meta_stats[Path(n).name]={'rows':len(rows),'cols':rdr.fieldnames,'family_counts':Counter(r['family'] for r in rows),'st_counts':Counter(r['st'] for r in rows),'pool_unique':len({r['Pool_code'] for r in rows})}

# correlations for total.txt only and combined maybe no scipy; Pearson and Spearman homemade
def pearson(xs,ys):
    n=len(xs); mx=sum(xs)/n; my=sum(ys)/n
    vx=sum((x-mx)**2 for x in xs); vy=sum((y-my)**2 for y in ys)
    if vx==0 or vy==0: return None
    return sum((x-mx)*(y-my) for x,y in zip(xs,ys))/math.sqrt(vx*vy)

def ranks(vals):
    pairs=sorted((v,i) for i,v in enumerate(vals)); out=[0]*len(vals); i=0
    while i<len(pairs):
        j=i
        while j<len(pairs) and pairs[j][0]==pairs[i][0]: j+=1
        rank=(i+j-1)/2+1
        for _,idx in pairs[i:j]: out[idx]=rank
        i=j
    return out

def spearman(xs,ys):
    return pearson(ranks(xs),ranks(ys))

for fname in ['total.txt','intestine.txt','lung.txt']:
    rows=[r for r in all_rows if r['_file']==fname]
    if rows:
        cols=[c for c in rows[0].keys() if c not in ('Pool_code','family','st','_file')]
        rel=[]
        tvs=[float(r['tvs']) for r in rows]
        for c in cols:
            if c=='tvs': continue
            xs=[float(r[c]) for r in rows]
            rel.append((c, pearson(tvs,xs), spearman(tvs,xs)))
        meta_stats[fname]['tvs_summary']=summarize_lengths([float(r['tvs']) for r in rows])
        meta_stats[fname]['sp_summary']=summarize_lengths([float(r['sp']) for r in rows])
        meta_stats[fname]['corr_top_abs_spearman']=sorted(rel, key=lambda x: abs(x[2] or 0), reverse=True)[:6]
        # means by family and st
        fam=defaultdict(list); st=defaultdict(list)
        for r in rows:
            fam[r['family']].append(float(r['tvs'])); st[r['st']].append(float(r['tvs']))
        meta_stats[fname]['mean_tvs_by_family']={k:sum(v)/len(v) for k,v in fam.items()}
        meta_stats[fname]['mean_tvs_by_st']={k:sum(v)/len(v) for k,v in st.items()}

# Phylo zip nested tars
phylo_stats={}
with zipfile.ZipFile(root/'48306316_ML_Phylo.zip') as z:
    for n in z.namelist():
        if n.endswith('.tar.gz'):
            blob=io.BytesIO(z.read(n))
            with tarfile.open(fileobj=blob, mode='r:gz') as tar:
                members=[m.name for m in tar.getmembers() if m.isfile()]
                # count seqs in main faa files
                counts={}
                for m in tar.getmembers():
                    base=Path(m.name).name
                    if m.isfile() and base.endswith('.faa') and (base==n.replace('.tar.gz','.faa') or base.endswith('trimmed.80.faa') or base.endswith('trimmed.faa')):
                        f=tar.extractfile(m)
                        seq_headers=[]; lens=[]; prefixes=Counter()
                        for h,seq in fasta_iter_text(f):
                            seq_headers.append(h); lens.append(len(seq))
                            prefixes[h.split('_')[0].split('|')[0].split('.')[0]]+=1
                        counts[base]={'n':len(seq_headers),'lengths':summarize_lengths(lens),'first':seq_headers[:3],'prefixes_top':prefixes.most_common(5)}
                phylo_stats[n]={'n_files':len(members),'members':members[:20],'counts':counts}

print('CONTIG_STATS')
print(contig_stats)
print('\\nMARKER_STATS')
for k,v in marker_stats.items(): print(k, v)
print('\\nMOTIF_STATS')
print(motif_stats)
print('\\nMETA_STATS')
for k,v in meta_stats.items(): print(k, v)
print('\\nPHYLO_STATS')
for k,v in phylo_stats.items(): print(k, v)
