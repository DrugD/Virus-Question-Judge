        if mc: covs.append(float(mc.group(1)))
    contig_stats={'lengths':num_summary(lengths),'pools_n':len(pools),'top_pools':pools.most_common(10),'cov_summary':num_summary(covs),'top_contigs':sorted(top, reverse=True)[:5]}

