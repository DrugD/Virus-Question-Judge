import tarfile, zipfile, io, re, csv, statistics, math
from pathlib import Path
from collections import Counter, defaultdict
root=Path('data')

def fasta_iter_text(fh):
    name=None; parts=[]
    for raw in fh:
        if isinstance(raw, bytes): raw=raw.decode('utf-8','replace')
        line=raw.strip()
        if not line: continue
        if line.startswith('>'):
            if name is not None: yield name, ''.join(parts)
            name=line[1:]; parts=[]
        else: parts.append(line)
    if name is not None: yield name, ''.join(parts)

def num_summary(vals):
    vals=[float(x) for x in vals]
    if not vals: return {}
    s=sorted(vals)
    return {'n':len(s),'min':s[0],'median':statistics.median(s),'mean':statistics.mean(s),'max':s[-1],'total':sum(s)}

contig_stats={}
with tarfile.open(root/'43059583_BtCN-Virome_full_spectrum_contigs.tar.gz','r:gz') as tar:
    f=tar.extractfile('BtCN-Virome_full_spectrum.fna')
    lengths=[]; covs=[]; pools=Counter(); top=[]
    for h,seq in fasta_iter_text(f):
        L=len(seq); lengths.append(L); pool=h.split('|')[0]; pools[pool]+=1; top.append((L,h))
        mc=re.search(r'_cov_([0-9.]+)', h)
        if mc: covs.append(float(mc.group(1)))
    contig_stats={'lengths':num_summary(lengths),'pools_n':len(pools),'top_pools':pools.most_common(10),'cov_summary':num_summary(covs),'top_contigs':sorted(top, reverse=True)[:5]}

marker_stats={}
with tarfile.open(root/'43059592_CytB-COI-ITS.tar.gz','r:gz') as tar:
    for m in tar.getmembers():
        if m.isfile() and m.name.lower().endswith(('.fna','.fasta','.fas')):
            f=tar.extractfile(m)
            lengths=[]; first=[]
            for h,seq in fasta_iter_text(f):
                lengths.append(len(seq))
                if len(first)<3: first.append(h[:140])
            marker_stats[m.name]={'lengths':num_summary(lengths),'first_headers':first}

try:
    import openpyxl
