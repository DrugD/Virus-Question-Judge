+{
+  "agent_id": "gpt-5.5-codex-harness",
+  "questions": [
+    {
+      "rank": 1,
+      "question": "Do the reported invertebrate viral RNA-dependent RNA polymerase sequences reveal host-associated lineages that bridge or expand established negative-sense RNA virus families?",
+      "rationale": "The FASTA contains 170 viral nucleotide records, including 82 polymerase/RdRp-related entries and 113 unique virus names from ticks, mosquitoes, flies, spiders, shrimp, crabs, water striders, and other invertebrates. The EPS figure supplements place these new viruses among Orthomyxovirus/Quaranjavirus, Phlebovirus/Arenavirus/Hantavirus/Orthobunyavirus/Tospovirus/Emaravirus, and Rhabdovirus/Bornavirus/Nyamivirus/Chuvirus contexts. This makes evolutionary placement of invertebrate polymerase sequences the most direct high-value question supported by both data modalities.",
+      "data_support": [
+        "data/nuccore_reported_viral_sequences.fasta headers with RNA-dependent RNA polymerase and host-associated virus names",
+        "data/elife-05378-supp-v1.zip Figure_3_Figure_Supplement_1.eps phylogeny labels",
+        "data/elife-05378-supp-v1.zip Figure_3_Figure_Supplement_2.eps phylogeny labels",
+        "data/elife-05378-supp-v1.zip Figure_3_Figure_Supplement_3.eps phylogeny labels"
+      ],
+      "expected_test": "Extract RdRp/L/PB1 coding sequences from the FASTA, align them with the named reference taxa shown in the EPS phylogenies, infer phylogenetic trees, and test whether invertebrate-derived viruses form distinct clades or occupy positions between recognized negative-sense RNA virus families.",
+      "scope_keywords": [
+        "RdRp",
+        "invertebrate virome",
+        "negative-sense RNA viruses",
+        "phylogeny",
+        "host-associated lineages"
+      ]
+    },
+    {
+      "rank": 2,
+      "question": "Are tick-associated viral sequences disproportionately represented in polymerase, glycoprotein, and nucleocapsid markers compared with other invertebrate host groups in this dataset?",
+      "rationale": "Tick-labeled records are the largest host cue group in the FASTA, with 38 records and 25 unique virus names, while mosquitoes, flies, insects, spiders, and other invertebrates are also represented. Many entries are separated into polymerase, glycoprotein, and nucleocapsid records, allowing marker coverage to be compared across host-associated names. This question is biologically relevant because marker completeness affects whether tick-associated viruses can be placed robustly in negative-sense RNA virus evolution.",
+      "data_support": [
+        "data/nuccore_reported_viral_sequences.fasta host cues in viral names",
+        "data/nuccore_reported_viral_sequences.fasta gene annotations for RNA-dependent RNA polymerase, glycoprotein, and nucleocapsid"
+      ],
+      "expected_test": "Parse virus names for host cues, classify each record by annotated marker, count unique viruses and records per host category, and use contingency tests or enrichment ratios to compare tick-associated marker representation with other host-associated groups.",
+      "scope_keywords": [
+        "ticks",
+        "gene markers",
+        "polymerase",
+        "glycoprotein",
+        "nucleocapsid",
+        "surveillance bias"
+      ]
+    },
+    {
+      "rank": 3,
+      "question": "Do segmented invertebrate virus records in the FASTA correspond to phylogenetic placements near known segmented negative-sense RNA virus groups?",
+      "rationale": "The FASTA includes 10 headers annotated as segments and 14 PB1 records, alongside many L-polymerase, glycoprotein, and nucleocapsid entries. The figure supplements include segmented-virus contexts such as Orthomyxovirus/Quaranjavirus and multiple bunyavirus-related groups. Testing whether segment annotations align with those phylogenetic neighborhoods could clarify genome organization transitions among invertebrate viruses.",
+      "data_support": [
+        "data/nuccore_reported_viral_sequences.fasta segment headers",
+        "data/nuccore_reported_viral_sequences.fasta PB1 and polymerase annotations",
+        "data/elife-05378-supp-v1.zip Figure_3_Figure_Supplement_1.eps",
+        "data/elife-05378-supp-v1.zip Figure_3_Figure_Supplement_2.eps"
+      ],
+      "expected_test": "Filter FASTA entries with segment or PB1 annotations, map their virus names onto the EPS phylogeny labels, and compare their clade positions against known segmented virus groups represented in the figures.",
+      "scope_keywords": [
+        "segmented genomes",
+        "PB1",
+        "orthomyxovirus",
+        "bunyavirus",
+        "genome organization"
+      ]
+    },
+    {
+      "rank": 4,
+      "question": "Which invertebrate host-associated virus groups have enough paired polymerase, glycoprotein, and nucleocapsid sequence data to support comparative genome-architecture analysis?",
+      "rationale": "The dataset has 82 polymerase-related records, 49 glycoprotein records, and 48 nucleocapsid records, with 31 virus names containing all three marker classes and 60 containing at least two marker classes. These marker combinations are unevenly distributed across host cues such as tick, mosquito, fly, spider, shrimp, and water strider. Identifying sufficiently sampled groups is a prerequisite for testing how genome structure varies across invertebrate viruses.",
+      "data_support": [
+        "data/nuccore_reported_viral_sequences.fasta marker annotations",
+        "data/nuccore_reported_viral_sequences.fasta virus names and strain names"
+      ],
+      "expected_test": "Group records by virus name, flag the presence of polymerase, glycoprotein, and nucleocapsid markers, summarize marker completeness by host cue, and compare genome-architecture feature availability among groups.",
+      "scope_keywords": [
+        "genome architecture",
+        "marker completeness",
+        "invertebrate hosts",
+        "comparative virology"
+      ]
+    },
+    {
+      "rank": 5,
+      "question": "Do sequence length and completeness annotations differ systematically among the host-associated viral records reported from ticks, mosquitoes, flies, and other invertebrates?",
+      "rationale": "The FASTA spans 170 records totaling 1,048,737 nucleotides, with lengths from 898 to 15,462 nt and a median of 6,275.5 nt. It includes 7 complete genomes, 138 complete CDS records, 16 partial CDS records, and host-associated labels that can be grouped from viral names. Differences in completeness by host group would affect downstream discovery and evolutionary interpretation.",
+      "data_support": [
+        "data/nuccore_reported_viral_sequences.fasta sequence lengths",
+        "data/nuccore_reported_viral_sequences.fasta complete genome, complete cds, and partial cds annotations",
+        "data/nuccore_reported_viral_sequences.fasta host-associated virus names"
+      ],
+      "expected_test": "Calculate sequence length distributions and completeness-label frequencies by parsed host cue, then compare groups using summary statistics and nonparametric tests or contingency tables.",
+      "scope_keywords": [
+        "sequence completeness",
+        "host groups",
+        "FASTA annotations",
+        "length distribution"
+      ]
+    }
+  ]
+}
