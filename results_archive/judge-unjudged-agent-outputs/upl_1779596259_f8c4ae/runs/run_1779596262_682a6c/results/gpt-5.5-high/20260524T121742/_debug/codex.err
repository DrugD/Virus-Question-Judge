codex
Ghostscript’s text extraction recovered the phylogenetic labels: the figure supplements place the new sequences among Orthomyxoviridae, Bunyavirales/Arenaviridae, Rhabdoviridae, Bornaviridae, Nyamiviridae, and Chuvirus-like groups. I’m doing one more pass over the FASTA headers for counts by host cue and gene marker before writing the outputs.
exec
/bin/zsh -lc "python - <<'PY'
from pathlib import Path
from collections import Counter, defaultdict
import re, statistics, math
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]; h=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if h: records.append((h,''.join(seq).upper()))
        h=line[1:]; seq=[]
    else:
        seq.append(line.strip())
if h: records.append((h,''.join(seq).upper()))

def virus_name(h):
    m=re.match(r'\\S+\\s+(.+?)\\s+strain\\s+', h, re.I)
    if m: return m.group(1)
    return re.sub(r'"'^'"\\S+\\s+','',h).split(',')[0]

def host_cat(name):
    nl=name.lower()
    if 'louse fly' in nl: return 'louse fly'
    if 'horsefly' in nl or ' fly ' in (' '+nl+' ') or 'fly virus' in nl or 'mothfly' in nl: return 'fly'
    for cat in ['tick','mosquito','spider','shrimp','crab','cockroach','water strider','bedbug','millipede','ant','lacewing','insect']:
        if cat in nl: return cat
    return 'other/unclear'

names=[virus_name(h) for h,s in records]
byhost=Counter(host_cat(n) for n in names)
byhost_unique=Counter()
for n in set(names): byhost_unique[host_cat(n)]+=1
print('records by host cat', byhost)
print('unique viruses by host cat', byhost_unique)
# source geography prefix maybe city/place first token
prefixes=Counter(n.split()[0] for n in names)
print('top place/name prefixes',prefixes.most_common(15))
# gene categories exclusive-ish
cats=Counter()
for h,s in records:
    hl=h.lower()
    if 'rna-dependent rna polymerase' in hl or 'polymerase (l)' in hl or 'polymerase gene' in hl: cats['RdRp/L polymerase']+=1
    if 'glycoprotein' in hl: cats['glycoprotein']+=1
    if 'nucleocapsid' in hl: cats['nucleocapsid']+=1
    if 'pb1' in hl: cats['PB1']+=1
    if 'complete genome' in hl: cats['complete genome']+=1
    if 'segment' in hl: cats['segmented entries']+=1
    if 'complete cds' in hl: cats['complete cds']+=1
    if 'partial cds' in hl: cats['partial cds']+=1
print('cats',cats)
# paired markers unique viruses with both L/G/N records? derive per name
markers=defaultdict(set)
for h,s in records:
    hl=h.lower(); n=virus_name(h)
    if 'rna-dependent rna polymerase' in hl or 'polymerase (l)' in hl or 'polymerase gene' in hl: markers[n].add('L')
    if 'glycoprotein' in hl: markers[n].add('G')
    if 'nucleocapsid' in hl: markers[n].add('N')
    if 'pb1' in hl: markers[n].add('PB1')
    if 'complete genome' in hl: markers[n].add('genome')
print('viruses with L,G,N',sum({'L','G','N'}<=m for m in markers.values()))
print('viruses with >=2 markers',sum(len(m)>=2 for m in markers.values()))
print('gc_overall', round(sum(s.count('G')+s.count('C') for h,s in records)/sum(len(s) for h,s in records)*100,2))
for cat in byhost_unique:
    vals=[len(s) for (h,s),n in zip(records,names) if host_cat(n)==cat]
    print(cat, len(vals), 'median_len', int(statistics.median(vals)), 'max', max(vals))
