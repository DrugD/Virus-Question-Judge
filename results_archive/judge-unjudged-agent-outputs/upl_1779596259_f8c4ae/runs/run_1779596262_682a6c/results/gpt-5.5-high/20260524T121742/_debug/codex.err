codex
The FASTA headers show viral accessions from many arthropod-associated hosts, with repeated gene/segment labels such as RNA-dependent RNA polymerase, glycoprotein, and nucleocapsid. I’m extracting the figure labels from the EPS files now to recover the phylogenetic context those sequences were published with.
exec
/bin/zsh -lc 'for f in $(unzip -Z1 data/elife-05378-supp-v1.zip); do printf '"'\\n### %s\\n' \""'$f"; unzip -p data/elife-05378-supp-v1.zip "$f" | strings | rg -i '"'virus|viridae|polymerase|glycoprotein|nucleocapsid|rhabdo|bunya|arena|orthomyxo|figure|chu|phasi|tick|mosquito|fly|spider|shrimp|water|strider|crab|cockroach|louse|millipede|bedbug' | sed -n '1,240p'; done" in /private/tmp/codex-sandboxes/gpt-5.5-high/20260524T121742
exec
/bin/zsh -lc "python - <<'PY'
from pathlib import Path
from collections import Counter, defaultdict
import re, statistics
p=Path('data/nuccore_reported_viral_sequences.fasta')
records=[]
header=None; seq=[]
for line in p.read_text().splitlines():
    if line.startswith('>'):
        if header: records.append((header,''.join(seq)))
        header=line[1:]; seq=[]
    else:
        seq.append(line.strip())
if header: records.append((header,''.join(seq)))
print('n_records',len(records))
lengths=[len(s) for h,s in records]
print('total_nt',sum(lengths),'min',min(lengths),'max',max(lengths),'median',statistics.median(lengths),'mean',round(statistics.mean(lengths),1))
print('complete genome',sum('complete genome' in h.lower() for h,s in records))
print('complete cds',sum('complete cds' in h.lower() for h,s in records),'partial cds',sum('partial cds' in h.lower() for h,s in records))
print('segment headers',sum('segment' in h.lower() for h,s in records))
features=['RNA-dependent RNA polymerase','polymerase','glycoprotein','nucleocapsid','PB1','complete genome','segment','matrix protein','phosphoprotein','NSs','ORF']
for feat in features:
    print(feat, sum(feat.lower() in h.lower() for h,s in records))
host_words=['Tick','Mosquito','Fly','Louse Fly','Spider','Insect','Shrimp','Crab','Cockroach','Water Strider','Bedbug','Millipede','Ant','Lacewing','Mothfly','Horsefly']
for hw in host_words:
    print('host',hw, sum(hw.lower() in h.lower() for h,s in records))
# parse virus names up to strain
names=[]
for h,s in records:
    m=re.match(r'\\S+\\s+(.+?)\\s+strain\\s+', h, flags=re.I)
    if m: names.append(m.group(1))
    else:
        # before gene phrase maybe
        names.append(h.split(',')[0])
print('unique virus names',len(set(names)))
print('top name duplicates')
for name,c in Counter(names).most_common(15): print(c,name)
print('accession range',records[0][0].split()[0],records[-1][0].split()[0])
# ambiguous bases
amb=sum(sum(1 for ch in s.upper() if ch not in 'ACGT') for h,s in records)
print('ambiguous bases',amb)
# length quantiles
for q in [0,0.25,0.5,0.75,0.9,1]:
    vals=sorted(lengths); idx=int(q*(len(vals)-1)); print('q',q, vals[idx])
