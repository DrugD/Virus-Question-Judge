The FASTA headers encode a viral grouping, virus name, optional genome segment/gene label, and sequence length. I’m going to compute counts by group, sequence length distributions, segmented-genome patterns, and alignment/tree coverage from the ZIP.
exec
/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from collections import Counter, defaultdict
import re, statistics, zipfile
f=Path('data/5905698_all_virus_genomes.fasta')
records=[]
seq_id=None; seq=[]
for line in f.open():
    line=line.strip()
    if not line: continue
    if line.startswith('>'):
        if seq_id:
            records.append((seq_id,''.join(seq)))
        seq_id=line[1:]
        seq=[]
    else:
        seq.append(line.upper())
if seq_id: records.append((seq_id,''.join(seq)))
print('FASTA records', len(records))
lengths=[]; mism=[]; groups=Counter(); genes=Counter(); species_counter=Counter(); sample_prefix=Counter(); source_prefix=Counter()
by_group=defaultdict(list); virus_segments=defaultdict(list); virus_seqids=defaultdict(list)
for h,s in records:
    m=re.search(r'_(?:l|L)en(\\d+)"'$'"', h)
    L=int(m.group(1)) if m else len(s)
    lengths.append(L)
    if L "'!= len(s): mism.append((h,L,len(s)))
    # split header: seqid_group_rest_len
    base=re.sub(r'"'_(?:l|L)en\\d+"'$'"','',h)
    parts=base.split('_')
    sid=parts[0]
    grp=parts[1] if len(parts)>1 else ''
    groups[grp]+=1; by_group[grp].append(L)
    # detect gene/segment from common terminal tokens before len, including GenBank accessions maybe before gene
    term=parts[-1] if parts else ''
    if term in {'RdRp','Glycoprotein','Nucleoprotein','NS','Sdomain','ORF1','ORF2','ORF3','Capsid','N','G','L','M','S'}:
        genes[term]+=1
        virus_name='_'.join(parts[2:-1])
        gene=term
    else:
        # sometimes accession before gene: ... KM817697_RdRp
        if len(parts)>=2 and parts[-2].startswith(('KM','NC','KX','KT','JQ','AY','DQ','EU','HQ','KF','KP','AF','AB')) and term in {'RdRp','Glycoprotein','Nucleoprotein','NS'}:
            gene=term; genes[term]+=1; virus_name='_'.join(parts[2:-2])
        else:
            gene='whole/unspecified'; genes[gene]+=1; virus_name='_'.join(parts[2:])
    sample_prefix[re.match(r'[A-Za-z]+', sid).group(0) if re.match(r'[A-Za-z]+', sid) else re.match(r'\\d*[A-Za-z]+', sid).group(0) if re.match(r'\\d*[A-Za-z]+', sid) else sid]+=1
    species_counter[(grp,virus_name)]+=1
    virus_segments[(grp,virus_name)].append(gene)
    virus_seqids[(grp,virus_name)].append(sid)
print('length declared mismatches', len(mism))
print('total nt', sum(lengths), 'min', min(lengths), 'median', statistics.median(lengths), 'mean', round(statistics.mean(lengths),1), 'max', max(lengths))
print('length quantiles', {q: sorted(lengths)[int(len(lengths)*q/100)] for q in [5,25,50,75,95]})
print('\\nTop groups by records:')
for g,c in groups.most_common():
    vals=by_group[g]
    print(f'{g}\\t{c}\\tmedian_len={statistics.median(vals):.0f}\\tmean_len={statistics.mean(vals):.0f}\\tmin={min(vals)}\\tmax={max(vals)}')
print('\\nGene/segment labels:')
for k,v in genes.most_common(): print(k,v)
print('\\nunique virus names (group,name):', len(species_counter))
seg_counts=Counter(len(set(v)) for v in virus_segments.values())
print('distinct gene labels per virus-name distribution', seg_counts)
print('viruses with >=2 gene labels', sum(1 for v in virus_segments.values() if len(set(v))>=2))
print('viruses with >=3 gene labels', sum(1 for v in virus_segments.values() if len(set(v))>=3))
print('\\nTop repeated virus names by sequence count:')
for (g,name),c in species_counter.most_common(20):
    print(g,c,name, sorted(set(virus_segments[(g,name)])))
print('\\nTop sample prefixes:')
for p,c in sample_prefix.most_common(30): print(p,c)
# host-ish tokens in virus names
host_terms=['mosquito','insect','shrimp','crab','worm','leech','spider','tick','fly','horsefly','bedbug','barnacle','fluke','ascaridia','myriapoda','lepidoptera','odonata','cixiid','aphid','beetle','moth','mite','dragonfly','plant','zucchini','bean','bat','human','avian','fish']
host_counter=Counter()
for (g,name),c in species_counter.items():
    lname=name.lower()
    for t in host_terms:
        if t in lname: host_counter[t]+=c
print('\\nHost/name token sequence counts:')
for t,c in host_counter.most_common(): print(t,c)
# alignment zip stats
zip_path=Path('data/5905695_alignments_and_phylogenies.zip')
with zipfile.ZipFile(zip_path) as z:
    infos=z.infolist()
    fas=[i for i in infos if i.filename.endswith(('.fas','.fasta'))]
    nwk=[i for i in infos if i.filename.endswith('.nwk')]
    print('\\nzip files', len(infos), 'fas', len(fas), 'nwk', len(nwk))
    align_stats=[]
    for info in fas:
        txt=z.read(info).decode('utf-8', errors='replace').splitlines()
        hs=[]; seq=''; seqs=[]
        cur=None
        for line in txt:
            line=line.strip()
            if not line: continue
            if line.startswith('>'):
                if cur is not None: seqs.append((cur,seq))
                cur=line[1:]; seq=''
            else: seq += line.strip()
        if cur is not None: seqs.append((cur,seq))
        alen=len(seqs[0][1]) if seqs else 0
        gap_fracs=[]
        for h,s in seqs:
            gap_fracs.append((s.count('-')+s.count('.'))/len(s) if s else 0)
        align_stats.append((info.filename, len(seqs), alen, round(statistics.mean(gap_fracs),3) if gap_fracs else 0))
    print('\\nalignment stats filename\\tnseq\\talen\\tmean_gap')
    for row in sorted(align_stats, key=lambda x:x[1], reverse=True): print('\\t'.join(map(str,row)))
