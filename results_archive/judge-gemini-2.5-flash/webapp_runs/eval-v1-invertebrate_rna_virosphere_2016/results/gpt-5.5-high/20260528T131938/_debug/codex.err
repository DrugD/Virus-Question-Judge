import re, zipfile, json, statistics, collections, math
from pathlib import Path
root=Path('data')
fasta=root/'5905698_all_virus_genomes.fasta'
records=[]
name=None; seq=[]
with fasta.open() as fh:
    for line in fh:
        line=line.strip()
        if not line: continue
        if line.startswith('>'):
            if name is not None:
                records.append((name,''.join(seq)))
            name=line[1:]
            seq=[]
        else:
            seq.append(line.upper())
    if name is not None:
        records.append((name,''.join(seq)))
print('records',len(records))
lengths=[len(s) for _,s in records]
print('length min median mean max total',min(lengths),statistics.median(lengths),round(statistics.mean(lengths),1),max(lengths),sum(lengths))
# len in header check
mismatch=0
for h,s in records:
    m=re.search(r'_len(\\d+)"'$'"',h)
    if not m or int(m.group(1))"'!=len(s): mismatch+=1
print('"'len header mismatches',mismatch)
# parse header: accession_group_rest_len
families=collections.Counter()
viruses=collections.Counter()
genes=collections.Counter()
locations=collections.Counter()
accessions=[]
for h,s in records:
    parts=h.split('_')
    acc=parts[0]; group=parts[1] if len(parts)>1 else ''
    accessions.append(acc)
    families[group]+=1
    rest='_'.join(parts[2:])
    rest=re.sub(r'_len\\d+"'$'"','',rest)
    # common terminal gene names?
    gene='unspecified'
    for g in ['RdRp','Nucleoprotein','Glycoprotein','Nucleocapsid','Capsid','polyprotein','RNA1','RNA2','RNA3','Segment1','Segment2','Segment3']:
        if rest.endswith('_'+g) or rest==g:
            gene=g; break
    # if includes Beihai/Changjiang/Wenzhou etc first word location
    if rest:
        loc=rest.split('_')[0]
        locations[loc]+=1
    genes[gene]+=1
    viruses[rest]+=1
print('groups',len(families), families.most_common())
print('top locations',locations.most_common(20))
print('genes',genes.most_common(20))
print('unique rest/virus labels',len(viruses),'accessions unique',len(set(accessions)))
print('top repeated virus labels', [x for x in viruses.most_common(20) if x[1]>1])
# Length by family top
for fam,n in families.most_common():
    fl=[len(s) for h,s in records if h.split('_')[1]==fam]
    print('family_len',fam,n,min(fl),int(statistics.median(fl)),max(fl),round(statistics.mean(fl),1))
# zip parse
zip_path=root/'5905695_alignments_and_phylogenies.zip'
with zipfile.ZipFile(zip_path) as z:
    names=z.namelist()
    print('zip files',len(names),'fas',sum(n.endswith(('.fas','.fasta')) for n in names),'nwk',sum(n.endswith('.nwk') for n in names))
    topdir=collections.Counter(n.split('/')[0] if '/' in n else '.' for n in names)
    print('zip dirs',topdir)
    align_stats=[]
    tree_stats=[]
    for n in names:
        data=z.read(n).decode('utf-8',errors='replace')
        if n.endswith(('.fas','.fasta')):
            rec=[]; nm=None; sq=[]
            for line in data.splitlines():
                line=line.strip()
                if not line: continue
                if line.startswith('>'):
                    if nm is not None: rec.append((nm,''.join(sq)))
                    nm=line[1:]; sq=[]
                else: sq.append(line)
            if nm is not None: rec.append((nm,''.join(sq)))
            lens=[len(s) for _,s in rec]
            nongap=[sum(1 for c in s if c not in '-.') for _,s in rec]
            align_stats.append((n,len(rec),min(lens) if lens else 0,max(lens) if lens else 0, statistics.mean(lens) if lens else 0, statistics.mean(nongap) if nongap else 0))
        elif n.endswith('.nwk'):
            # labels roughly tokens before : or , ) ( ; after removing branch lengths tokens? robust enough
            labels=re.findall(r'[(,](["'^():,;]+):'"', '('+data)
            tree_stats.append((n,len(labels),data.count(':')))
    print('alignment files',len(align_stats))
    total_seqs=sum(x[1] for x in align_stats)
    print('alignment seq total',total_seqs,'min/max seqs per aln',min(x[1] for x in align_stats),max(x[1] for x in align_stats))
    print('largest alignments by seq count')
    for x in sorted(align_stats,key=lambda t:t[1], reverse=True)[:10]: print(x)
    print('smallest alignments by seq count')
    for x in sorted(align_stats,key=lambda t:t[1])[:10]: print(x)
    print('tree files',len(tree_stats),'total leaves rough',sum(x[1] for x in tree_stats),'minmax',min(x[1] for x in tree_stats),max(x[1] for x in tree_stats))
    print('largest trees')
    for x in sorted(tree_stats,key=lambda t:t[1], reverse=True)[:10]: print(x)
    # names groups from alignment filenames
    print('alignment names')
    for x in align_stats: print(x[0],x[1],x[2],x[3],round(x[5],1))
