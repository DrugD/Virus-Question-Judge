import zipfile,re,collections
from pathlib import Path
# map accession to group/name in genome fasta
acc_group={}; acc_name={}
for block in Path('data/5905698_all_virus_genomes.fasta').read_text().split('>'):
    if not block.strip(): continue
    h=block.splitlines()[0]
    parts=h.split('_')
    acc_group[parts[0]]=parts[1]
    acc_name[parts[0]]='_'.join(parts[2:])
with zipfile.ZipFile('data/5905695_alignments_and_phylogenies.zip') as z:
    for fname in [n for n in z.namelist() if n.startswith('RdRp_versus_structural/Structure_') and n.endswith('.fas')]:
        data=z.read(fname).decode()
        groups=collections.Counter(); total=0; known=0; labels=[]
        for line in data.splitlines():
            if not line.startswith('>'): continue
            total+=1
            label=line[1:]
            # remove prefix up to first _, then take candidate tokens; exact accession IDs in labels sometimes after Sdomain_
            tail=label.split('_',1)[1] if '_' in label else label
            # match any accession as exact token or leading before -seg
            cand=tail.split('_')[0].split('-')[0]
            if cand in acc_group:
                groups[acc_group[cand]]+=1; known+=1
            else:
                # maybe no accession reference
                pass
        print(fname, 'total',total,'known_accessions',known,'groups',groups.most_common())
