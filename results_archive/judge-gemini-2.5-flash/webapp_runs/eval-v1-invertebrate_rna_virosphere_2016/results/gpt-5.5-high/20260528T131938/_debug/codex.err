/bin/zsh -lc "python3 - <<'PY'
import re, zipfile, collections, statistics
from pathlib import Path

def fasta_records(text):
    rec=[]; nm=None; sq=[]
    for line in text.splitlines():
        line=line.strip()
        if not line: continue
        if line.startswith('>'):
            if nm is not None: rec.append((nm,''.join(sq)))
            nm=line[1:]; sq=[]
        else: sq.append(line)
    if nm is not None: rec.append((nm,''.join(sq)))
    return rec

def newick_leaves(s):
    # simple parse: collect label token after '(' or ',' until delimiter (:, comma, paren, semicolon)
    leaves=[]; i=0; expect_label=True
    while i < len(s):
        c=s[i]
        if c in '(,':
            j=i+1
            # skip whitespace
            while j<len(s) and s[j].isspace(): j+=1
            if j<len(s) and s[j] in '(),;':
                i+=1; continue
            # quoted label
            if j<len(s) and s[j] in \"'\\\"\":
                q=s[j]; k=j+1
                while k<len(s) and s[k]"'!=q: k+=1
                label=s[j+1:k]
                leaves.append(label)
                i=k+1; continue
            k=j
            while k<len(s) and s[k] not in '"':,();': k+=1
            label=s[j:k].strip()
            if label and not re.fullmatch(r'[0-9.Ee+-]+', label):
                leaves.append(label)
            i=k; continue
        i+=1
    return leaves

# FASTA parse details
text=Path('data/5905698_all_virus_genomes.fasta').read_text()
recs=fasta_records(text)
print('FASTA records',len(recs))
print('FASTA headers first 10')
for h,s in recs[:10]: print(h)
# derive terminal feature labels by suffix known
suffixes=['RdRp','Nucleoprotein','Glycoprotein','Capsid','Unknown','RNA1','RNA2','RNA3']
features=collections.Counter(); group_feature=collections.defaultdict(collections.Counter)
base_counts=collections.Counter()
for h,s in recs:
    body=re.sub(r'_len\\d+"'$'"','',h)
    parts=body.split('_')
    group=parts[1]
    rest='_'.join(parts[2:])
    feat='whole_or_unlabeled'
    base=rest
    for suf in suffixes:
        if rest.endswith('_'+suf):
            feat=suf; base=rest[:-(len(suf)+1)]; break
    features[feat]+=1; group_feature[group][feat]+=1; base_counts[(group,base)]+=1
print('feature suffixes',features.most_common())
multi=[(g,b,c) for (g,b),c in base_counts.items() if c>1]
print('multi same group+base count',len(multi),'records in multi',sum(c for _,_,c in multi))
print('top multi',sorted(multi,key=lambda x:x[2],reverse=True)[:20])
# possible segmented: groups with multiple features for same base
base_feats=collections.defaultdict(set)
for h,s in recs:
    body=re.sub(r'_len\\d+"'$'"','',h); parts=body.split('_'); group=parts[1]; rest='_'.join(parts[2:])
    feat='whole_or_unlabeled'; base=rest
    for suf in suffixes:
        if rest.endswith('_'+suf): feat=suf; base=rest[:-(len(suf)+1)]; break
    base_feats[(group,base)].add(feat)
seg=[(g,b,sorted(fs)) for (g,b),fs in base_feats.items() if len(fs)>1]
print('bases with multiple feature suffix types',len(seg))
print(seg[:20])
# GC content by group maybe
bygroup=collections.defaultdict(list); gcgrp=collections.defaultdict(list)
for h,s in recs:
    group=h.split('_')[1]
    bygroup[group].append(len(s))
    acgt=sum(s.count(x) for x in 'ACGT')
    gc=(s.count('G')+s.count('C'))/acgt if acgt else 0
    gcgrp[group].append(gc)
print('GC by group top count')
for g,n in collections.Counter({g:len(v) for g,v in bygroup.items()}).most_common():
    print(g, len(bygroup[g]), round(100*statistics.mean(gcgrp[g]),1), round(100*min(gcgrp[g]),1), round(100*max(gcgrp[g]),1))
# zip tree alignment matching
with zipfile.ZipFile('data/5905695_alignments_and_phylogenies.zip') as z:
    align_counts={}; tree_counts={}; examples=[]
    for n in z.namelist():
        data=z.read(n).decode('utf-8',errors='replace')
        if n.endswith('.fas'):
            align_counts[n]=len(fasta_records(data))
        elif n.endswith('.nwk'):
            tree_counts[n]=len(newick_leaves(data))
    print('tree counts')
    for n,c in sorted(tree_counts.items()): print(n,c)
    # normalize pair names
    pairs=[]
    for a,c in align_counts.items():
        # find possible tree in same dir with shared prefix
        base=a[:-4]
        # different suffixes
        candidates=[]
        if base.endswith('_trimmed_alignment'):
            pref=base[:-len('_trimmed_alignment')]
            candidates=[pref+'_phylogeny.nwk']
        elif base.endswith('_trimal'):
            pref=base
            candidates=[pref+'.phy_phyml_tree.nwk', pref+'.nwk']
        t=next((x for x in candidates if x in tree_counts), None)
        pairs.append((a,c,t,tree_counts.get(t)))
    print('pairs alignment tree')
    for p in pairs: print(p)
